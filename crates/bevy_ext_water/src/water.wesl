// Vael volumetric physical water shader — two-pass Beer-Lambert absorption
// (`AlphaMode::Multiply`, pass_mode < 0.5) + subsurface volume scattering,
// multi-scale capillary & Gerstner swells, GPU dispersive iWave ripples, and
// real PBR lighting/shadows/IBL/point-light reflections (`AlphaMode::Add`,
// pass_mode >= 0.5).
//
// MESH CONTRACT (see `terrain/water.rs`):
//   COLOR.rgb = body water color, COLOR.a = geometric outer skirt fade mask
//   UV_0.x    = extinction murkiness (`opacity`)
//   UV_0.y    = baked vertical bed column (fallback when prepass unavailable)
//   UV_1.xy   = surface flow velocity `(vx, vz)` m/s (`> 3.9` or tilted normal = waterfall)

import bevy_pbr::render::forward_io::{Vertex, UncompressedVertex, VertexOutput, FragmentOutput, decompress_vertex};
import bevy_pbr::render::pbr_fragment::pbr_input_from_standard_material;
import bevy_pbr::render::pbr_functions::{alpha_discard, apply_pbr_lighting, apply_fog, main_pass_post_lighting_processing};
import bevy_pbr::render::pbr_types::STANDARD_MATERIAL_FLAGS_FOG_ENABLED_BIT;
import bevy_pbr::render::mesh_view_bindings::{globals, view, fog};
import bevy_pbr::render::view_transformations as vt;
@if(DEPTH_PREPASS)
import bevy_pbr::prepass::utils::prepass_depth;
import bevy_pbr::render::mesh_bindings::mesh;
import bevy_pbr::render::mesh_functions;
import bevy_pbr::render::skinning;
import bevy_pbr::render::morph::{morph_position, morph_normal, morph_tangent, layer_count, weight_at};

struct WaterUniforms {
    // (origin_x, origin_z, world_size_m, texel_m)
    wave_window: vec4<f32>,
    // (sun_dir.x, sun_dir.y, sun_dir.z, day_factor)
    sun_dir_day: vec4<f32>,
    // (sun_tint.rgb, glint_strength)
    sun_color_glint: vec4<f32>,
    // (zenith.rgb, rain_intensity)
    sky_zenith_rain: vec4<f32>,
    // (horizon.rgb, elapsed_time)
    sky_horizon_time: vec4<f32>,
    // (wind_x, wind_z, wind_strength, wave_amp)
    wind_params: vec4<f32>,
    // (pass_mode [0=absorb, 1=surface_add], caustic_gain, scatter_gain, depth_fade_max)
    pass_params: vec4<f32>,
};

@group(constants::MATERIAL_BIND_GROUP) @binding(100) var<uniform> water_params: WaterUniforms;
@group(constants::MATERIAL_BIND_GROUP) @binding(101) var wave_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(102) var wave_sampler: sampler;
@group(constants::MATERIAL_BIND_GROUP) @binding(103) var domain_tex: texture_2d<f32>;
@group(constants::MATERIAL_BIND_GROUP) @binding(104) var domain_sampler: sampler;
@group(constants::MATERIAL_BIND_GROUP) @binding(105) var obstacle_tex: texture_2d<f32>;

// === WORLD CONFIG (generated by `viber run` — edit the XML, not this block) ===
const CFG_DRIVE: f32 = 1.0;
const CFG_CLOCK_START: f32 = 480.0;
const CFG_CLOCK_SPEED: f32 = 1.2;
const CFG_DAWN: f32 = 330.0;
const CFG_DUSK: f32 = 1170.0;
const CFG_MAX_ELEV: f32 = 62.0;
const CFG_MIN_ELEV: f32 = 8.0;
const CFG_AZ_BASE: f32 = 205.0;
const CFG_SUN_ELEV: f32 = 17.0;
const CFG_SUN_AZ: f32 = 205.0;
const CFG_WIND_X: f32 = 0.7;
const CFG_WIND_Z: f32 = 0.25;
const CFG_WIND_STRENGTH: f32 = 1.5;
const CFG_WAVE_AMP: f32 = 1.0;
// === END WORLD CONFIG ===

// Wavelength extinction per meter of water column (red absorbs fastest, blue deepest).
const EXTINCTION: vec3<f32> = vec3<f32>(0.64, 0.23, 0.13);
const MAX_PATH: f32 = 55.0;
const SHORE_FEATHER_M: f32 = 0.14;
const VERTEX_WAVE_GAIN: f32 = 0.18;
const PI: f32 = 3.141592653589793;
const MOON_ELEVATION_DEG: f32 = 52.0;

// ── Noise & solar fallbacks ─────────────────────────────────────────────────

fn hash21(p: vec2<f32>) -> f32 {
    let q = vec2<i32>(floor(p));
    var h = (bitcast<u32>(q.x) * 0x27d4eb2du) ^ (bitcast<u32>(q.y) * 0x165667b1u);
    h = (h ^ (h >> 15u)) * 0x2c1b3c6du;
    h = (h ^ (h >> 13u)) * 0x297a2d39u;
    h = h ^ (h >> 16u);
    return f32(h & 0x00ffffffu) * (1.0 / 16777216.0);
}

fn value_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let a = hash21(i);
    let b = hash21(i + vec2(1.0, 0.0));
    let c = hash21(i + vec2(0.0, 1.0));
    let d = hash21(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

fn fbm(p: vec2<f32>, drift: vec2<f32>) -> f32 {
    let rot = mat2x2<f32>(0.80, 0.60, -0.60, 0.80);
    var q = p;
    var amp = 0.5;
    var sum = 0.0;
    var norm = 0.0;
    for (var i = 0; i < 4; i += 1) {
        sum += (value_noise(q + drift * (1.0 + f32(i) * 0.35)) - 0.5) * amp;
        norm += amp;
        q = rot * q * 2.03 + vec2(11.7, 5.3);
        amp *= 0.5;
    }
    return sum / norm;
}

fn sun_elevation_deg(minute: f32, dawn: f32, dusk: f32, max_elevation: f32) -> f32 {
    if (minute >= dawn && minute < dusk) {
        let t = (minute - dawn) / (dusk - dawn);
        return sin(PI * t) * max_elevation;
    }
    let dusk_len = 24.0 * 60.0 - dusk + dawn;
    var t = (minute - dusk) / dusk_len;
    if (minute < dusk) {
        t = (minute + (24.0 * 60.0 - dusk)) / dusk_len;
    }
    return -abs(sin(PI * t)) * 25.0;
}

fn sun_azimuth_deg(minute: f32, dawn: f32, dusk: f32, base: f32) -> f32 {
    if (minute >= dawn && minute < dusk) {
        return base + 180.0 * (minute - dawn) / (dusk - dawn);
    }
    let dusk_len = 24.0 * 60.0 - dusk + dawn;
    var t = (minute - dusk) / dusk_len;
    if (minute < dusk) {
        t = (minute + (24.0 * 60.0 - dusk)) / dusk_len;
    }
    return base + 180.0 + 180.0 * t;
}

fn sky_direction(elevation_deg: f32, azimuth_deg: f32) -> vec3<f32> {
    let el = radians(elevation_deg);
    let az = radians(azimuth_deg);
    return normalize(vec3<f32>(cos(el) * sin(az), sin(el), cos(el) * cos(az)));
}

// ── Multi-component Gerstner trochoidal swells + interactive wave field ──────

fn active_wind() -> vec3<f32> {
    let wx = select(CFG_WIND_X, water_params.wind_params.x, water_params.wind_params.z > 0.0);
    let wz = select(CFG_WIND_Z, water_params.wind_params.y, water_params.wind_params.z > 0.0);
    let ws = select(CFG_WIND_STRENGTH, water_params.wind_params.z, water_params.wind_params.z > 0.0);
    return vec3<f32>(wx, wz, clamp(ws, 0.08, 3.0));
}

fn active_amp() -> f32 {
    let wa = water_params.wind_params.w;
    return select(CFG_WAVE_AMP, wa, wa > 0.01);
}

fn active_time() -> f32 {
    let wt = water_params.sky_horizon_time.w;
    return select(globals.time, wt, wt > 0.0);
}

// Computes `(uv_x, uv_y, win_mask)` inside the active 128 m wave window once per query.
fn window_uv_mask(world_xz: vec2<f32>, margin_m: f32) -> vec3<f32> {
    let wsize = water_params.wave_window.z;
    if wsize < 1.0 {
        return vec3<f32>(0.0);
    }
    let uv = (world_xz - water_params.wave_window.xy) / wsize;
    let margin = margin_m / wsize;
    let bx = smoothstep(0.0, margin, uv.x) * (1.0 - smoothstep(1.0 - margin, 1.0, uv.x));
    let bz = smoothstep(0.0, margin, uv.y) * (1.0 - smoothstep(1.0 - margin, 1.0, uv.y));
    let win_mask = bx * bz;
    return vec3<f32>(uv.x, uv.y, win_mask);
}

fn sample_interactive_wave(world_xz: vec2<f32>) -> vec4<f32> {
    let uvm = window_uv_mask(world_xz, 6.0);
    if uvm.z <= 0.001 {
        return vec4<f32>(0.0);
    }
    return textureSampleLevel(wave_tex, wave_sampler, clamp(uvm.xy, vec2<f32>(0.0), vec2<f32>(1.0)), 0.0) * uvm.z;
}

// Samples `(depth_m * win_mask, d_depth_dx, d_depth_dz)` + obstacle-deflected current in 3 fetches instead of 4.
struct DomainInfo {
    bank_grad: vec3<f32>,
    flow: vec2<f32>,
};

fn sample_domain_info(world_xz: vec2<f32>, fallback_flow: vec2<f32>) -> DomainInfo {
    let uvm = window_uv_mask(world_xz, 6.0);
    if uvm.z <= 0.001 {
        return DomainInfo(vec3<f32>(0.0), fallback_flow);
    }
    let uv = clamp(uvm.xy, vec2<f32>(0.0), vec2<f32>(1.0));
    let win_mask = uvm.z;
    let step_uv = 1.0 / 256.0;
    let dom = textureSampleLevel(domain_tex, domain_sampler, uv, 0.0);
    let d0 = max(dom.x, 0.0);
    let dx = max(textureSampleLevel(domain_tex, domain_sampler, clamp(uv + vec2<f32>(step_uv, 0.0), vec2<f32>(0.0), vec2<f32>(1.0)), 0.0).x, 0.0);
    let dz = max(textureSampleLevel(domain_tex, domain_sampler, clamp(uv + vec2<f32>(0.0, step_uv), vec2<f32>(0.0), vec2<f32>(1.0)), 0.0).x, 0.0);
    let bank_grad = vec3<f32>(d0, dx - d0, dz - d0) * win_mask;
    let flow = mix(fallback_flow, dom.yz, win_mask * smoothstep(0.0, 0.04, dom.x));
    return DomainInfo(bank_grad, flow);
}

// Returns `(signed_dist_m, obs_nx, obs_nz, obs_radius_m)` from `obstacle_tex`.
fn sample_obstacle(world_xz: vec2<f32>) -> vec4<f32> {
    let uvm = window_uv_mask(world_xz, 4.0);
    if uvm.z <= 0.001 {
        return vec4<f32>(8.0, 1.0, 0.0, 0.0);
    }
    let obs = textureSampleLevel(obstacle_tex, domain_sampler, clamp(uvm.xy, vec2<f32>(0.0), vec2<f32>(1.0)), 0.0);
    let halo = clamp(obs.x, 0.0, 2.0);
    if halo <= 0.01 {
        return vec4<f32>(8.0, 1.0, 0.0, 0.0);
    }
    let signed_dist = mix(8.0, (1.0 - halo) * 4.0, uvm.z);
    let n = normalize(select(vec2<f32>(1.0, 0.0), obs.yz, dot(obs.yz, obs.yz) > 1e-4));
    return vec4<f32>(signed_dist, n.x, n.y, max(obs.w, 0.25));
}

// Returns `(dx, dy, dz, steepness)` for 4 directional Gerstner trochoidal wave trains.
fn gerstner_swell(p: vec2<f32>, t: f32) -> vec4<f32> {
    let w = active_wind();
    let wdir = normalize(w.xy + vec2<f32>(1e-4, 0.0));
    let strength = w.z;
    let amp = active_amp();
    let speed = 0.68 + 0.45 * strength;

    let warp = vec2<f32>(
        value_noise(p * 0.085 + vec2<f32>(t * 0.025, 0.0)),
        value_noise(p * 0.095 - vec2<f32>(0.0, t * 0.022)),
    ) * 1.8 - vec2<f32>(0.9);
    let q = p + warp;

    let d0 = wdir;
    let d1 = vec2<f32>(wdir.x * 0.829 - wdir.y * 0.559, wdir.x * 0.559 + wdir.y * 0.829);
    let d2 = vec2<f32>(wdir.x * 0.629 + wdir.y * 0.777, -wdir.x * 0.777 + wdir.y * 0.629);
    let d3 = vec2<f32>(wdir.x * 0.292 - wdir.y * 0.956, wdir.x * 0.956 + wdir.y * 0.292);

    let gain = VERTEX_WAVE_GAIN * (0.45 + 0.40 * clamp(strength, 0.2, 2.2)) * amp;
    var disp = vec3<f32>(0.0);
    var steep = 0.0;

    // Wave train 0
    {
        let k = 0.58;
        let a = 0.28 * gain;
        let ph = dot(q, d0) * k - t * sqrt(9.81 * k) * 0.42 * speed;
        let c = cos(ph);
        let s = sin(ph);
        disp += vec3<f32>(d0.x * a * 0.55 * c, a * s, d0.y * a * 0.55 * c);
        steep += clamp(k * a * c, -0.5, 1.0);
    }
    // Wave train 1
    {
        let k = 0.96;
        let a = 0.20 * gain;
        let ph = dot(q, d1) * k + t * sqrt(9.81 * k) * 0.36 * speed;
        let c = cos(ph);
        let s = sin(ph);
        disp += vec3<f32>(d1.x * a * 0.52 * c, a * s, d1.y * a * 0.52 * c);
        steep += clamp(k * a * c, -0.5, 1.0);
    }
    // Wave train 2
    {
        let k = 1.54;
        let a = 0.13 * gain;
        let ph = dot(q, d2) * k - t * sqrt(9.81 * k) * 0.32 * speed;
        let c = cos(ph);
        let s = sin(ph);
        disp += vec3<f32>(d2.x * a * 0.48 * c, a * s, d2.y * a * 0.48 * c);
        steep += clamp(k * a * c, -0.5, 1.0);
    }
    // Wave train 3
    {
        let k = 2.48;
        let a = 0.08 * gain;
        let ph = dot(q, d3) * k + t * sqrt(9.81 * k) * 0.29 * speed;
        let c = cos(ph);
        let s = sin(ph);
        disp += vec3<f32>(d3.x * a * 0.45 * c, a * s, d3.y * a * 0.45 * c);
        steep += clamp(k * a * c, -0.5, 1.0);
    }

    return vec4<f32>(disp, clamp(steep * 0.45 + 0.35, 0.0, 1.0));
}

fn wave_height(p: vec2<f32>, t: f32) -> f32 {
    let w = active_wind();
    let wdir = normalize(w.xy + vec2<f32>(1e-4, 0.0));
    let strength = w.z;
    let speed = 0.7 + 0.5 * strength;

    let warp = vec2<f32>(
        value_noise(p * 0.11 + vec2<f32>(t * 0.03, 0.0)),
        value_noise(p * 0.13 - vec2<f32>(0.0, t * 0.025)),
    ) * 2.2 - vec2<f32>(1.1);
    let q = p + warp;

    let d0 = wdir;
    let d1 = vec2<f32>(wdir.x * 0.829 - wdir.y * 0.559, wdir.x * 0.559 + wdir.y * 0.829);
    let d2 = vec2<f32>(wdir.x * 0.629 + wdir.y * 0.777, -wdir.x * 0.777 + wdir.y * 0.629);
    let d3 = vec2<f32>(wdir.x * 0.292 - wdir.y * 0.956, wdir.x * 0.956 + wdir.y * 0.292);

    let k0 = 0.897; let k1 = 1.366; let k2 = 2.094; let k3 = 3.396;
    var h = 0.0;
    h += sin(dot(q, d0) * k0 - t * sqrt(k0) * 1.35 * speed) * 0.22;
    h += sin(dot(q, d1) * k1 + t * sqrt(k1) * 1.10 * speed) * 0.18;
    h += sin(dot(q, d2) * k2 - t * sqrt(k2) * 0.95 * speed) * 0.12;
    h += sin(dot(q, d3) * k3 + t * sqrt(k3) * 0.80 * speed) * 0.07;

    let drift = wdir * t * 0.35 * speed;
    h += fbm(q * 0.9 + drift, drift * 0.4) * 0.32 * (0.6 + 0.4 * min(strength, 2.0));
    return h * active_amp();
}

// Dual-phase flow-advected micro-ripple heightfield so river currents race naturally
// without UV stretching.
fn advected_capillary_height(p: vec2<f32>, flow: vec2<f32>, t: f32) -> f32 {
    let w = active_wind();
    let wdir = normalize(w.xy + vec2<f32>(1e-4, 0.0));
    let speed = length(flow);
    if speed < 0.05 {
        let swell = wave_height(p, t) * 0.08;
        let micro = fbm(p * 2.8 + wdir * t * 0.48, -wdir * t * 0.20) * 0.048;
        let detail = (value_noise(p * 7.6 - wdir * t * 0.92) - 0.5) * 0.024;
        return swell + micro + detail;
    }
    let cycle = 1.65;
    let p0 = fract(t / cycle);
    let p1 = fract(t / cycle + 0.5);
    let w0 = 1.0 - abs(p0 * 2.0 - 1.0);
    let w1 = 1.0 - abs(p1 * 2.0 - 1.0);
    var cap = 0.0;
    if w0 > 0.005 {
        let uv0 = p - flow * (p0 * cycle);
        let n0 = fbm(uv0 * 2.4, vec2<f32>(0.0)) * 0.062 + (value_noise(uv0 * 6.4) - 0.5) * 0.028;
        cap += n0 * w0;
    }
    if w1 > 0.005 {
        let uv1 = p - flow * (p1 * cycle);
        let n1 = fbm(uv1 * 2.4 + vec2<f32>(17.3, 9.1), vec2<f32>(0.0)) * 0.062
            + (value_noise(uv1 * 6.4 + vec2<f32>(5.2, 13.7)) - 0.5) * 0.028;
        cap += n1 * w1;
    }
    return cap + wave_height(p - flow * 0.12 * t, t) * 0.048;
}

// High-frequency raindrop micro-rings for storm atmosphere.
fn rain_ripple_ring_slope(p: vec2<f32>, t: f32, rain: f32) -> vec2<f32> {
    if rain < 0.02 {
        return vec2<f32>(0.0);
    }
    var acc = vec2<f32>(0.0);
    let cell = floor(p * 1.6);
    for (var dz: i32 = -1; dz <= 1; dz = dz + 1) {
        for (var dx: i32 = -1; dx <= 1; dx = dx + 1) {
            let c = cell + vec2<f32>(f32(dx), f32(dz));
            let h = hash21(c);
            if h < rain * 0.72 {
                let phase = fract(t * (1.25 + 0.65 * h) + h * 7.3);
                let center = (c + vec2<f32>(0.2 + 0.6 * hash21(c + 3.1), 0.2 + 0.6 * hash21(c + 9.7))) / 1.6;
                let delta = p - center;
                let dist = length(delta);
                let ring_r = phase * 0.42;
                let band = exp(-pow((dist - ring_r) * 18.0, 2.0));
                let life = (1.0 - phase) * smoothstep(0.0, 0.12, phase);
                let dir = delta / max(dist, 1e-3);
                acc += dir * (band * life * sin((dist - ring_r) * 38.0) * 0.32 * rain);
            }
        }
    }
    return acc;
}

fn wave_normal(p: vec2<f32>, t: f32, damp: f32) -> vec3<f32> {
    let e = 0.10;
    let hl = wave_height(p - vec2<f32>(e, 0.0), t);
    let hr = wave_height(p + vec2<f32>(e, 0.0), t);
    let hd = wave_height(p - vec2<f32>(0.0, e), t);
    let hu = wave_height(p + vec2<f32>(0.0, e), t);
    let g = vec2<f32>(hr - hl, hu - hd) * (0.5 / e) * damp;
    return normalize(vec3<f32>(-g.x, 1.0, -g.y));
}

fn caustic_sample(p: vec2<f32>, t: f32) -> f32 {
    let w1 = p * 2.15 + vec2<f32>(t * 0.32, -t * 0.22);
    let w2 = vec2<f32>(p.x * 0.80 - p.y * 0.60, p.x * 0.60 + p.y * 0.80) * 2.95
           - vec2<f32>(t * 0.27, t * 0.34);
    let v1 = abs(sin(w1.x + sin(w1.y * 1.3 + t * 0.82)) + cos(w1.y + cos(w1.x * 1.1 - t * 0.61)));
    let v2 = abs(sin(w2.x + cos(w2.y * 1.2 - t * 0.72)) + cos(w2.y + sin(w2.x * 1.4 + t * 0.92)));
    let web = min(v1, v2);
    return pow(clamp(1.0 - web * 0.78, 0.0, 1.0), 4.6);
}

// ── Vertex Shader ───────────────────────────────────────────────────────────

@if(MORPH_TARGETS)
fn morph_vertex(vertex_in: UncompressedVertex, instance_index: u32) -> UncompressedVertex {
    var vertex = vertex_in;
    let first_vertex = mesh[instance_index].first_vertex_index;
    let vertex_index = vertex.index - first_vertex;
    let morph_descriptor_index = mesh[instance_index].morph_descriptor_index;

    let weight_count = layer_count(morph_descriptor_index);
    for (var i: u32 = 0u; i < weight_count; i++) {
        let weight = weight_at(i, morph_descriptor_index);
        if weight == 0.0 {
            continue;
        }
        vertex.position += weight * morph_position(vertex_index, i, morph_descriptor_index);
        @if(VERTEX_NORMALS)
        vertex.normal += weight * morph_normal(vertex_index, i, morph_descriptor_index);
        @if(VERTEX_TANGENTS)
        vertex.tangent += vec4(morph_tangent(vertex_index, i, morph_descriptor_index), 0.0);
    }
    return vertex;
}

@vertex
fn vertex(vertex_no_morph: Vertex) -> VertexOutput {
    var out: VertexOutput;

    let uncompressed = decompress_vertex(vertex_no_morph, vertex_no_morph.instance_index);
    @if(MORPH_TARGETS)
    var vertex = morph_vertex(uncompressed, vertex_no_morph.instance_index);
    @else
    var vertex = uncompressed;

    let mesh_world_from_local = mesh_functions::get_world_from_local(vertex_no_morph.instance_index);

    @if(SKINNED)
    var world_from_local = skinning::skin_model(
        vertex.joint_indices,
        vertex.joint_weights,
        vertex_no_morph.instance_index
    );
    @else
    var world_from_local = mesh_world_from_local;

    @if(VERTEX_NORMALS && SKINNED)
    out.world_normal = skinning::skin_normals(world_from_local, vertex.normal);
    @if(VERTEX_NORMALS && !SKINNED)
    out.world_normal = mesh_functions::mesh_normal_local_to_world(
        vertex.normal,
        vertex_no_morph.instance_index
    );

    @if(VERTEX_POSITIONS)
    out.world_position = mesh_functions::mesh_position_local_to_world(world_from_local, vec4<f32>(vertex.position, 1.0));

    @if(VERTEX_POSITIONS && VERTEX_COLORS)
    {
        let t = active_time();
        var v_flow = vec2<f32>(0.0);
        var flow_speed = 0.0;
        @if(VERTEX_UVS_B)
        {
            v_flow = vertex.uv_b;
            flow_speed = length(v_flow);
        }
        var baked_depth = 1.5;
        @if(VERTEX_UVS_A)
        {
            baked_depth = vertex.uv.y;
        }
        let geom_n = normalize(out.world_normal);
        let is_waterfall = (flow_speed > 3.9) || (abs(geom_n.y) < 0.72);
        let cam_dist = length(view.world_position - out.world_position.xyz);
        let dist_damp = 1.0 - smoothstep(45.0, 125.0, cam_dist);
        let edge_mask = smoothstep(0.14, 0.72, vertex.color.a);
        let deep_swell = edge_mask * smoothstep(0.38, 1.35, baked_depth);
        let mid_wave = edge_mask * smoothstep(0.08, 0.52, baked_depth);

        if is_waterfall {
            let ripple = sin(out.world_position.y * 1.4 - t * 8.5 + out.world_position.x * 1.7) * 0.045;
            out.world_position += vec4<f32>(geom_n * (ripple * dist_damp), 0.0);
        } else {
            let swell = gerstner_swell(out.world_position.xz, t);
            let interactive = sample_interactive_wave(out.world_position.xz);
            let obs_v = sample_obstacle(out.world_position.xz);
            let obs_damp = smoothstep(-0.20, 0.25, obs_v.x);
            let obs_impact = max(-dot(v_flow, obs_v.yz), 0.0);
            let bow_rise = clamp(obs_impact, 0.0, 2.5) * 0.028
                * smoothstep(-0.12, 0.14, obs_v.x)
                * smoothstep(1.40, 0.08, obs_v.x);
            let inter_lift = clamp(interactive.x, -0.18, 0.18) * 0.58;
            let swell_lift = clamp(swell.y, -0.12, 0.12) * 0.78;
            let h_lift = ((swell_lift * deep_swell + inter_lift * mid_wave) * obs_damp + bow_rise * mid_wave) * dist_damp;
            let xz_chop = swell.xz * (deep_swell * dist_damp * obs_damp * 0.45);
            out.world_position = vec4<f32>(
                out.world_position.x + xz_chop.x,
                out.world_position.y + h_lift,
                out.world_position.z + xz_chop.y,
                out.world_position.w,
            );
        }
    }

    @if(VERTEX_POSITIONS)
    out.position = vt::position_world_to_clip(out.world_position.xyz);

    @if(VERTEX_UVS_A)
    out.uv = vertex.uv;
    @if(VERTEX_UVS_B)
    out.uv_b = vertex.uv_b;

    @if(VERTEX_TANGENTS)
    out.world_tangent = mesh_functions::mesh_tangent_local_to_world(
        world_from_local,
        vertex.tangent,
        vertex_no_morph.instance_index
    );

    @if(VERTEX_COLORS)
    out.color = vertex.color;

    @if(VERTEX_OUTPUT_INSTANCE_INDEX)
    out.instance_index = vertex_no_morph.instance_index;

    @if(VISIBILITY_RANGE_DITHER)
    out.visibility_range_dither = mesh_functions::get_visibility_range_dither_level(
        vertex_no_morph.instance_index, mesh_world_from_local[3]);

    return out;
}

// ── Fragment Shader ─────────────────────────────────────────────────────────

@fragment
fn fragment(
    in: VertexOutput,
    @builtin(front_facing) is_front: bool,
) -> FragmentOutput {
    var pbr_input = pbr_input_from_standard_material(in, is_front);
    pbr_input.material.base_color = alpha_discard(
        pbr_input.material.flags,
        pbr_input.material.alpha_cutoff,
        pbr_input.material.base_color
    );

    let t = active_time();
    let world = pbr_input.world_position.xyz;
    let body = pbr_input.material.base_color.rgb;
    let mask = clamp(pbr_input.material.base_color.a, 0.0, 1.0);

    var murk = 0.75;
    var baked_depth = 1.6;
    @if(VERTEX_UVS_A)
    {
        murk = clamp(in.uv.x, 0.05, 1.0);
        baked_depth = max(in.uv.y, 0.02);
    }

    var flow = vec2<f32>(0.0);
    @if(VERTEX_UVS_B)
    {
        flow = in.uv_b;
    }
    let flow_speed = length(flow);
    let geom_n = normalize(pbr_input.N);
    let is_waterfall = (flow_speed > 3.9) || (abs(geom_n.y) < 0.72);

    // Real per-pixel underwater bed depth via DEPTH_PREPASS (water itself has enable_prepass = false).
    let to_cam = normalize(view.world_position - world);
    var ray_thickness = clamp(baked_depth / max(abs(to_cam.y), 0.10), 0.02, MAX_PATH);
    var vert_depth = baked_depth;
    var bed_world = world - vec3<f32>(0.0, baked_depth, 0.0);

    @if(DEPTH_PREPASS)
    {
        let raw_depth = prepass_depth(in.position, 0u);
        if raw_depth > 0.0001 {
            let ndc = vt::frag_coord_to_ndc(in.position);
            let sample_world = vt::position_ndc_to_world(vec3<f32>(ndc.xy, raw_depth));
            bed_world = sample_world;
            ray_thickness = clamp(dot(world - sample_world, to_cam), 0.0, MAX_PATH);
            vert_depth = max(world.y - sample_world.y, 0.0);
            if is_waterfall {
                ray_thickness = clamp(ray_thickness, 0.18, 0.95);
                vert_depth = max(vert_depth, 0.35);
            }
        }
    }

    let interactive = sample_interactive_wave(world.xz);
    let inter_h = interactive.x;
    let inter_grad = interactive.yz;
    let inter_foam = clamp(interactive.w, 0.0, 1.0);

    let cam_dist = length(view.world_position - world);
    let damp = 1.0 / (1.0 + cam_dist * 0.011);
    let rain = clamp(water_params.sky_zenith_rain.w, 0.0, 1.0);

    // Depth strata + bank & obstacle boundary friction + deflected stream velocity.
    let shallow_t = 1.0 - smoothstep(0.16, 0.48, vert_depth);
    let wading_t = smoothstep(0.15, 0.42, vert_depth) * (1.0 - smoothstep(0.85, 1.45, vert_depth));
    let deep_t = smoothstep(0.80, 1.65, vert_depth);
    let dom_all = sample_domain_info(world.xz, flow);
    let dom_info = dom_all.bank_grad;
    let dom_slope = length(dom_info.yz);
    let obs = sample_obstacle(world.xz);
    let obs_dist = obs.x;
    let obs_n = obs.yz;
    let stream_flow = dom_all.flow;
    let bank_slow = 0.28 + 0.72 * smoothstep(0.03, 0.62, vert_depth);
    let flow_eff = stream_flow * bank_slow;
    let flow_eff_speed = length(flow_eff);

    // Combined surface normal: Gerstner swell + interactive compute wave gradients
    // + boundary-sheared flow advection + shallow swash + obstacle bow/wake ripples + rain micro-rings.
    var surf_normal = geom_n;
    var wave_crest_h = inter_h;
    if is_waterfall {
        let up_ref = select(vec3<f32>(0.0, 1.0, 0.0), vec3<f32>(0.0, 0.0, 1.0), abs(geom_n.y) > 0.92);
        let tangent_x = normalize(cross(up_ref, geom_n));
        let tangent_y = cross(geom_n, tangent_x);
        let rush = world.y * 1.7 + t * 8.0;
        let streak_a = fbm(vec2<f32>(dot(world, tangent_x) * 1.9, rush), vec2<f32>(0.0, t * 2.5));
        let streak_b = value_noise(vec2<f32>(dot(world, tangent_x) * 4.5, rush * 1.8));
        surf_normal = normalize(
            geom_n
            + tangent_x * ((streak_a * 0.42 + (streak_b - 0.5) * 0.25) * damp)
            + tangent_y * ((streak_a * 0.20) * damp),
        );
    } else {
        let swell = gerstner_swell(world.xz, t);
        wave_crest_h += swell.y * mix(0.24, 1.0, smoothstep(0.28, 1.10, vert_depth));
        let shallow_n = smoothstep(0.0, 0.10, vert_depth);
        if shallow_n > 0.001 && is_front {
            let ec = 0.09;
            let cx0 = advected_capillary_height(world.xz - vec2<f32>(ec, 0.0), flow_eff, t);
            let cx1 = advected_capillary_height(world.xz + vec2<f32>(ec, 0.0), flow_eff, t);
            let cz0 = advected_capillary_height(world.xz - vec2<f32>(0.0, ec), flow_eff, t);
            let cz1 = advected_capillary_height(world.xz + vec2<f32>(0.0, ec), flow_eff, t);
            let cap_grad = vec2<f32>(cx1 - cx0, cz1 - cz0) * (0.5 / ec);
            let cap_depth_gain = 1.40 * (0.48 + 0.52 * smoothstep(0.02, 0.28, vert_depth)) * (1.0 + 0.14 * wading_t + 0.24 * deep_t);

            // Shoreline boundary shear eddies (moving flow scraping banks/stones) + calm shore swash.
            var shear_grad = vec2<f32>(0.0);
            let bank_shear_mask = smoothstep(0.015, 0.08, vert_depth) * (1.0 - smoothstep(0.26, 0.62, vert_depth));
            if flow_speed > 0.18 && bank_shear_mask > 0.01 {
                let f_dir = flow / max(flow_speed, 1e-3);
                let f_perp = vec2<f32>(-f_dir.y, f_dir.x);
                let along = dot(world.xz, f_dir);
                let across = dot(world.xz, f_perp);
                let eddy = sin(along * 4.8 - t * (3.0 + flow_eff_speed * 2.2) + sin(across * 3.1) * 1.4)
                    * (value_noise(world.xz * 4.2 - flow_eff * (t * 0.45)) - 0.5);
                shear_grad = (f_perp * 0.75 + f_dir * 0.35) * (eddy * 0.52 * min(flow_speed, 2.5) * bank_shear_mask);
            }
            var obs_eddy_grad = vec2<f32>(0.0);
            if obs_dist < 3.6 && flow_speed > 0.14 {
                let obs_t = vec2<f32>(-obs_n.y, obs_n.x);
                let f_dir = flow / max(flow_speed, 1e-3);
                let f_perp = vec2<f32>(-f_dir.y, f_dir.x);
                let obs_impact = max(-dot(flow, obs_n), 0.0);
                let obs_graze = abs(dot(flow, obs_t));
                let bow_mask = smoothstep(-0.08, 0.08, obs_dist) * (1.0 - smoothstep(0.05, 1.35, obs_dist));
                let bow_wave = cos(obs_dist * 12.5 - t * (3.2 + obs_impact * 1.4))
                    * bow_mask * clamp(obs_impact * 0.35, 0.0, 0.55);
                let v_band = smoothstep(-0.04, 0.10, obs_dist) * (1.0 - smoothstep(0.12, 2.40, obs_dist));
                let wake_phase = dot(world.xz, f_dir) * 4.8 - abs(dot(world.xz, f_perp)) * 3.6 - t * (4.6 + flow_speed * 1.2);
                let v_ripples = sin(wake_phase) * v_band * clamp(obs_graze * 0.24, 0.0, 0.38);
                obs_eddy_grad = (obs_n * bow_wave + (obs_n * 0.6 + obs_t * 0.45) * v_ripples) * smoothstep(0.01, 0.10, vert_depth);
            }
            let swash_mask = smoothstep(0.008, 0.05, vert_depth) * (1.0 - smoothstep(0.14, 0.36, vert_depth));
            let in_dir = select(
                normalize(vec2<f32>(0.6, 0.8)),
                normalize(dom_info.yz),
                dom_slope > 1e-3,
            );
            let swash_phase = dot(world.xz, in_dir) * 9.5 + t * 2.2;
            let swash_grad = in_dir * (cos(swash_phase) * 0.095 * swash_mask * (0.65 + 0.35 * active_amp()));

            let rain_grad = rain_ripple_ring_slope(world.xz, t, rain);
            let inter_slope = inter_grad * (1.70 / (1.0 + length(inter_grad) * 0.45));
            let grad = (cap_grad * cap_depth_gain + inter_slope + rain_grad * 1.30 + shear_grad + obs_eddy_grad + swash_grad) * damp * shallow_n;
            let wave_n = normalize(vec3<f32>(-grad.x, 1.0, -grad.y));
            surf_normal = normalize(mix(geom_n, wave_n, 0.94));
        }
    }
    pbr_input.N = surf_normal;

    // Active sun/moon lighting parameters (synced live from AtmosphereState + sky fallback).
    var glint_dir = water_params.sun_dir_day.xyz;
    var day_factor = water_params.sun_dir_day.w;
    var glint_color = water_params.sun_color_glint.rgb;
    var glint_strength = water_params.sun_color_glint.w;
    if dot(glint_dir, glint_dir) < 0.25 {
        var minute = CFG_CLOCK_START;
        if CFG_DRIVE > 0.5 {
            minute = (CFG_CLOCK_START + CFG_CLOCK_SPEED * t) % 1440.0;
        }
        day_factor = clamp((minute - (CFG_DAWN - 60.0)) / 60.0, 0.0, 1.0)
            * (1.0 - clamp((minute - CFG_DUSK) / 60.0, 0.0, 1.0));
        let sun_el = sun_elevation_deg(minute, CFG_DAWN, CFG_DUSK, CFG_MAX_ELEV);
        let sun_az = sun_azimuth_deg(minute, CFG_DAWN, CFG_DUSK, CFG_AZ_BASE);
        let sun_world = sky_direction(max(sun_el, CFG_MIN_ELEV), sun_az);
        let moon_world = sky_direction(MOON_ELEVATION_DEG, sun_az + 180.0);
        glint_dir = normalize(mix(moon_world, sun_world, day_factor));
        glint_color = mix(vec3<f32>(0.40, 0.54, 0.86), vec3<f32>(1.0, 0.95, 0.85), day_factor);
        glint_strength = 0.22 + 0.78 * day_factor;
    }

    // Physical Fresnel reflectance (water IOR ~ 1.333 => F0 = 0.02).
    let n_fres = normalize(mix(geom_n, surf_normal, 0.35));
    let nv = clamp(dot(n_fres, pbr_input.V), 0.0, 1.0);
    let fres = mix(0.02, 1.0, pow(1.0 - nv, 5.0));

    // Smooth shoreline feathering & depth-stratified Beer-Lambert optical absorption.
    let edge_fade = smoothstep(0.0, SHORE_FEATHER_M, min(ray_thickness, max(vert_depth * 2.2, 0.02))) * mask;
    let shallow_bed = smoothstep(0.0, 0.10, vert_depth);
    let shore_feather = select(mask, edge_fade * max(shallow_bed, smoothstep(0.0, 0.16, ray_thickness)), !is_waterfall);

    let ext = EXTINCTION * (0.40 + 1.08 * murk) * mix(0.76, 1.24, deep_t);
    let beer_t = exp(-ray_thickness * ext);
    let absorb_t = mix(vec3<f32>(1.0), beer_t, shore_feather);

    // Shallow sunlit underwater caustics projected onto the real submerged bed/boots.
    var caustic = vec3<f32>(0.0);
    let sun_lit_vis = clamp(glint_dir.y * 2.2, 0.0, 1.0) * day_factor * (1.0 - 0.72 * rain);
    if !is_waterfall && sun_lit_vis > 0.01 && vert_depth > 0.01 && vert_depth < 6.0 {
        let refract_uv = bed_world.xz - glint_dir.xz * (vert_depth * 0.42) - flow_eff * (t * 0.25);
        let c_r = caustic_sample(refract_uv + vec2<f32>(0.018, 0.0), t);
        let c_g = caustic_sample(refract_uv, t);
        let c_b = caustic_sample(refract_uv - vec2<f32>(0.018, 0.0), t);
        let c_depth_fade = smoothstep(0.04, 0.26, vert_depth) * exp(-vert_depth * 0.46) * mix(1.16, 0.88, deep_t);
        let c_gain = select(0.95, water_params.pass_params.y * 0.82, water_params.pass_params.y > 0.01);
        caustic = vec3<f32>(c_r, c_g, c_b) * (sun_lit_vis * c_depth_fade * c_gain * damp) * glint_color;
    }

    // Organic multi-scale cellular lace & froth droplets: clear water gaps between crisp foam filaments.
    let ridge_noise = abs(fbm(world.xz * 3.4 - flow_eff * (t * 0.38), vec2<f32>(t * 0.15, -t * 0.11)));
    let web_hi = pow(clamp(1.0 - ridge_noise * 2.8, 0.0, 1.0), 1.8);
    let bubble_coarse = value_noise(world.xz * 6.8 - flow_eff * (t * 0.50) + vec2<f32>(t * 0.19, -t * 0.15));
    let bubble_fine = value_noise(world.xz * 15.5 - flow_eff * (t * 0.72) + vec2<f32>(-t * 0.27, t * 0.23));
    let foam_lace = clamp(web_hi * smoothstep(0.32, 0.78, bubble_coarse) + smoothstep(0.68, 0.94, bubble_fine) * 0.55, 0.0, 1.0);
    let shore_zone = 1.0 - smoothstep(0.08, 0.58, baked_depth);
    let contact_foam_band = (1.0 - smoothstep(0.008, 0.068, vert_depth)) * smoothstep(0.0, 0.014, vert_depth);
    let shore_agitation = 0.28 + 0.72 * smoothstep(0.0, 0.08, abs(wave_crest_h) + flow_speed * 0.22);
    let contact_foam = contact_foam_band * shore_zone * foam_lace * shore_agitation;
    let bank_shear_foam = smoothstep(0.24, 1.85, flow_speed)
        * (1.0 - smoothstep(0.03, 0.44, vert_depth))
        * smoothstep(0.0, 0.015, vert_depth)
        * (0.45 + 0.55 * clamp(dom_slope * 1.8, 0.0, 1.0))
        * foam_lace;
    var obs_collide_foam = 0.0;
    if obs_dist < 1.8 && flow_speed > 0.14 {
        let obs_t = vec2<f32>(-obs_n.y, obs_n.x);
        let obs_impact = max(-dot(flow, obs_n), 0.0);
        let obs_graze = abs(dot(flow, obs_t));
        let collar = smoothstep(-0.06, 0.03, obs_dist) * (1.0 - smoothstep(0.04, 0.62, obs_dist));
        let flank_tail = smoothstep(0.0, 0.06, obs_dist) * (1.0 - smoothstep(0.10, 1.45, obs_dist));
        let bow_froth = collar * smoothstep(0.18, 1.25, obs_impact) * (0.45 + 0.55 * foam_lace);
        let peel_froth = flank_tail * smoothstep(0.42, 1.75, obs_graze) * 0.52 * foam_lace;
        let obs_wet = smoothstep(0.0, 0.025, vert_depth);
        obs_collide_foam = (bow_froth + peel_froth) * obs_wet;
    }
    let crest_whitecap = smoothstep(0.075, 0.18, wave_crest_h) * smoothstep(0.42, 1.05, vert_depth) * foam_lace * 0.58;
    let splash_mask = smoothstep(0.18, 0.78, inter_foam);
    let splash_bubbles = clamp(foam_lace * 0.95 + smoothstep(0.62, 0.95, inter_foam) * smoothstep(0.66, 0.92, bubble_fine) * 0.35, 0.0, 1.0);
    let splash_foam = splash_mask * splash_bubbles;
    // Shallow, fast water folds into short standing riffles. The crests stay
    // over the bed while flecks travel through them in the deflected current.
    let detail_vis = (1.0 - smoothstep(28.0, 76.0, cam_dist)) * select(0.0, 1.0, is_front && !is_waterfall);
    let froude = flow_eff_speed * inverseSqrt(9.81 * max(baked_depth, 0.08));
    let riffle_zone = detail_vis * smoothstep(0.25, 0.78, froude) * smoothstep(0.12, 0.38, baked_depth);
    var riffle = 0.0;
    if riffle_zone > 0.001 {
        let dir = flow_eff / max(flow_eff_speed, 0.001);
        let phase = dot(world.xz, dir) * 4.2 + 4.8 * value_noise(world.xz * 0.68);
        let crest = smoothstep(0.58, 0.96, cos(phase + 0.35 * sin(t * 1.6)));
        riffle = riffle_zone * crest * (0.18 + 0.68 * foam_lace);
    }
    // Wind laps against calm banks in broken arcs that climb the depth
    // contours. Use bed depth so a wader cannot generate a false shoreline.
    let bank_zone = detail_vis * shore_zone * (1.0 - smoothstep(0.12, 0.65, flow_speed));
    var lap = 0.0;
    if bank_zone > 0.001 {
        let bank_noise = value_noise(world.xz * 0.48);
        let beat = baked_depth * 19.0 + t * 2.1 + 2.8 * bank_noise;
        lap = bank_zone * smoothstep(0.04, 0.15, baked_depth) * smoothstep(0.70, 0.98, cos(beat))
            * smoothstep(0.24, 0.74, bank_noise) * (0.16 + 0.42 * foam_lace);
    }
    let rapid_t = smoothstep(2.0, 3.6, flow_eff_speed) * foam_lace;
    let fall_streaks = select(0.0, 0.48 + 0.44 * fbm(vec2<f32>(world.x * 2.2 + world.z * 2.2, world.y * 0.9 + t * 5.2), vec2<f32>(0.0, t * 2.0)), is_waterfall);
    let foam = clamp((contact_foam * 0.65 + bank_shear_foam * 0.58 + obs_collide_foam * 0.65 + crest_whitecap + splash_foam * 0.82 + rapid_t * 0.65 + fall_streaks + riffle + lap) * mask, 0.0, 0.84);

    // Pass 1 transmission multiplier (`AlphaMode::Multiply`, pass_mode < 0.5).
    let pass1_mul = clamp(
        mix(vec3<f32>(1.0), absorb_t * (vec3<f32>(1.0) + caustic) * (1.0 - fres * 0.75) * (1.0 - foam * 0.76), shore_feather),
        vec3<f32>(0.0),
        vec3<f32>(1.45),
    );

    if water_params.pass_params.x < 0.5 {
        var out: FragmentOutput;
        out.color = vec4<f32>(pass1_mul, 1.0);
        return out;
    }

    // Pass 2 (`AlphaMode::Add`): volumetric scatter + backlit wave SSS + foam + PBR/sky reflections.
    // Liquid water has zero diffuse albedo: only foam reflects diffuse PBR light, preventing opaque milky haze over submerged beds/limbs.
    let vol_depth_alpha = 1.0 - exp(-ray_thickness * (0.42 + 0.55 * murk));
    let base_body = max(body, vec3<f32>(0.018, 0.068, 0.11));
    let shallow_tint = clamp(base_body * 0.96, vec3<f32>(0.0), vec3<f32>(1.0));
    let wading_tint = clamp(base_body * 0.82 + vec3<f32>(0.008, 0.044, 0.042), vec3<f32>(0.0), vec3<f32>(1.0));
    let deep_tint = clamp(base_body * 0.48 + vec3<f32>(0.002, 0.020, 0.058), vec3<f32>(0.0), vec3<f32>(1.0));
    let depth_t = clamp(1.0 - dot(absorb_t, vec3<f32>(1.0 / 3.0)), 0.0, 1.0);
    let mid_scatter = mix(shallow_tint, wading_tint, clamp(wading_t + deep_t, 0.0, 1.0));
    let scatter_albedo = mix(mid_scatter, deep_tint, clamp(deep_t * 0.85 + depth_t * 0.35, 0.0, 1.0))
        * vol_depth_alpha
        * (1.0 + 0.12 * clamp(wave_crest_h * 4.5, -1.0, 1.0));

    // Backlit subsurface scattering through raised Gerstner & impact wave crests.
    let sss_dir = normalize(glint_dir - surf_normal * 0.42);
    let backlit = pow(clamp(dot(pbr_input.V, -sss_dir), 0.0, 1.0), 3.0);
    let crest_thin = smoothstep(0.01, 0.14, wave_crest_h + 0.03);
    let sss_depth_gain = mix(0.45, 1.15, smoothstep(0.22, 1.05, vert_depth));
    let sss = vec3<f32>(0.06, 0.46, 0.40) * glint_color * (backlit * crest_thin * day_factor * (1.0 - foam) * 0.65 * sss_depth_gain);

    let foam_albedo = vec3<f32>(0.30, 0.34, 0.38);
    let surface_rgb = foam_albedo * (foam * shore_feather);

    pbr_input.material.base_color = vec4<f32>(surface_rgb, 1.0);
    // Keep Bevy GGX F0 tight so sunlit directional GGX tails don't wash out submerged shadows; crisp sun glints come via sparkle_lobe below.
    pbr_input.material.reflectance = vec3<f32>(mix(0.10, 0.06, foam) * shore_feather);
    let wind_rough = clamp(active_wind().z, 0.0, 3.0) * 0.016
        + rain * 0.04
        + bank_shear_foam * 0.18
        + obs_collide_foam * 0.22;
    pbr_input.material.perceptual_roughness = clamp(
        mix(0.022 + wind_rough * 0.35, 0.72, foam),
        0.020,
        0.95,
    );

    // Sun/moon glints + physical Fresnel sky-dome gradient reflections + volumetric in-scattering.
    let refl = reflect(-glint_dir, surf_normal);
    let sparkle_lobe = pow(max(dot(refl, pbr_input.V), 0.0), 220.0);
    let wdir = normalize(active_wind().xy + vec2<f32>(1e-4, 0.0));
    let sparkle = pow(value_noise(world.xz * 8.5 + wdir * (t * 1.9)), 3.0);
    let view_refl = reflect(-pbr_input.V, normalize(mix(n_fres, surf_normal, 0.72)));
    let env_zenith = max(water_params.sky_zenith_rain.rgb, vec3<f32>(0.03, 0.08, 0.18));
    let env_horizon = max(water_params.sky_horizon_time.rgb, vec3<f32>(0.10, 0.16, 0.24));
    let sky_refl = mix(env_horizon, env_zenith, pow(clamp(view_refl.y, 0.0, 1.0), 0.42));
    let grazing_fres = pow(clamp(1.0 - nv, 0.0, 1.0), 4.5);
    let sky_bounce = (sky_refl * grazing_fres * (0.28 + 0.50 * day_factor) + env_zenith * (0.004 + 0.008 * day_factor)) * (1.0 - 0.55 * rain) * (1.0 - foam);
    let deep_scatter_mask = smoothstep(0.18, 0.65, ray_thickness) * smoothstep(0.12, 0.55, vert_depth);
    let sun_above = 0.40 + 0.60 * clamp(glint_dir.y * 1.8, 0.0, 1.0);
    let water_inscatter = scatter_albedo * (deep_scatter_mask * (0.08 + 0.18 * day_factor * sun_above) * (1.0 - 0.45 * rain) * (1.0 - foam));
    let s_gain = select(1.0, water_params.pass_params.z, water_params.pass_params.z > 0.01);
    pbr_input.material.emissive = vec4<f32>(
        (sss + water_inscatter * s_gain + sky_bounce) * shore_feather
        + glint_color * (sparkle_lobe * sparkle * 0.72 * glint_strength * damp * (1.0 - foam) * shore_feather),
        1.0,
    );

    let lit = vec4<f32>(apply_pbr_lighting(pbr_input).rgb, 1.0);

    var fog_zero = vec3<f32>(0.0);
    @if(DISTANCE_FOG)
    if (pbr_input.material.flags & STANDARD_MATERIAL_FLAGS_FOG_ENABLED_BIT) != 0u {
        fog_zero = apply_fog(
            fog,
            vec4<f32>(0.0, 0.0, 0.0, 1.0),
            pbr_input.world_position.xyz,
            view.world_position.xyz,
            pbr_input.frag_coord.xy,
        ).rgb;
    }

    var out: FragmentOutput;
    out.color = main_pass_post_lighting_processing(pbr_input, lit);
    out.color = vec4<f32>(max(out.color.rgb - fog_zero * pass1_mul, vec3<f32>(0.0)), out.color.a);
    return out;
}
