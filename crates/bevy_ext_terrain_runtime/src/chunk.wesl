// Viber terrain material — UM material para o terreno inteiro.
//
// O splat é GLOBAL: 4 planos RGBA8 com os 13 pesos do pool por texel (~2 m),
// cozidos no CPU (`splat::generate_splats`) e lidos aqui com filtragem
// bilinear + mips — sem costuras de chunk. Por PIXEL ficam as 4 camadas de
// maior peso (renormalizadas); só essas são amostradas. A albedo leva uma
// 2.ª amostra rodada a outra escala, misturada por ruído de baixa
// frequência (anti-repetição), e o terreno todo uma variação macro de tom.
//
// WORLD SPECIALIZATION: `viber run` rewrites the CONFIG block below from the
// `<Terrain>` spec before the renderer loads this file.
//
// BINDINGS — o material é **bindless** (`TerrainChunkMaterial`), por escolha
// de layout (8 layers num material, slab partilhada): o SIGSEGV histórico do
// driver NVIDIA em `vkCreatePipelineLayout` com materiais não-bindless +
// `#[texture]` JÁ NÃO REPRODUZ no wgpu 30 + driver 615.71.09 (re-verificado
// ao vivo 2026-10-18 — ver layer_material.rs). As texturas vivem nos arrays
// partilhados de `bevy_render::bindless`; a tabela de índices (binding 0) é
// lida como `array<u32>` — camada `i` do mapa M em `M_BASE + 2i` (sampler no
// índice seguinte). Sem bindless o terreno desenha a cor plana das camadas
// (este shader só lê texturas pelas binding arrays).

import bevy_pbr::render::forward_io::{Vertex, VertexOutput, FragmentOutput, decompress_vertex};
import bevy_pbr::render::mesh_functions;
import bevy_pbr::render::view_transformations::position_world_to_clip;
import bevy_pbr::render::mesh_view_bindings::view;
// Pipeline PBR REAL: `apply_pbr_lighting` traz o sol direcional (com as
// cascades de sombra — o chão passa a receber as sombras das árvores/props),
// as luzes pontuais clusterizadas (as lanternas acendem o terreno à noite),
// a luz ambiente e o specular; `main_pass_post_lighting_processing` aplica a
// fog da câmara (define DISTANCE_FOG do view key + bit FOG_ENABLED abaixo).
// NÃO importar `bevy_pbr::pbr_fragment`: puxa `pbr_bindings::material_indices`
// (StandardMaterial) que CONFLITUA com a nossa tabela bindless em
// group(#{MATERIAL_BIND_GROUP}).binding(0) — o PbrInput é construído à mão.
import bevy_pbr::render::pbr_types::{pbr_input_new, STANDARD_MATERIAL_FLAGS_FOG_ENABLED_BIT};
import bevy_pbr::render::pbr_functions::{apply_pbr_lighting, main_pass_post_lighting_processing, calculate_view};
import bevy_pbr::render::pbr_lighting::perceptualRoughnessToRoughness;
import bevy_pbr::render::mesh_bindings::mesh;

@if(BINDLESS)
import bevy_render::bindless::{bindless_textures_2d, bindless_samplers_filtering};

// SSAO — a textura e o define vêm do view key (componente na câmara); sem o
// componente o bloco some e a oclusão fica 1.0.
@if(SCREEN_SPACE_AMBIENT_OCCLUSION)
import bevy_pbr::render::mesh_view_bindings::screen_space_ambient_occlusion_texture;
@if(SCREEN_SPACE_AMBIENT_OCCLUSION)
import bevy_pbr::ssao::utils::ssao_multibounce;

// === WORLD CONFIG (generated by `viber run` — edit the XML, not this block) ===
// HISTÓRICO: estes consts eram lidos pelo fragment; hoje os MESMOS valores
// entram no uniform (`TerrainChunkParams::walls_a`/`walls_b`, inicializados
// do XML pelo bootstrap) para `viber.debug.ground{...}` os mover AO VIVO.
// O bloco mantém-se por paridade com water/sky.
const CFG_TRI_SLOPE: f32 = 0.5;
const CFG_TRI_SOFT: f32 = 0.12;
const CFG_STRATA_SPACING: f32 = 4;
const CFG_STRATA_STRENGTH: f32 = 0.25;
const CFG_ROCK_DARKEN: f32 = 0.45;
const CFG_STREAK: f32 = 0.5;
const CFG_MOSS: f32 = 0.35;
// === END WORLD CONFIG ===

const LAYERS: u32 = 13u;
// Bindings da tabela (ver `TerrainChunkMaterial`): camada `i` em `BASE + 2i`.
const B_ALBEDO: u32 = 1u;
const B_NORMAL: u32 = 27u;
const B_HEIGHT: u32 = 53u;
const B_AO: u32 = 79u;
const B_ROUGH: u32 = 105u;
const B_SPLAT: u32 = 131u;
const B_SNOW: u32 = 139u;
const B_TRAIL: u32 = 141u;
const B_CLOUD: u32 = 143u;
const SNOW_CELLS: f32 = 256.0;
const SNOW_ALBEDO: vec3<f32> = vec3<f32>(0.80, 0.83, 0.88);
const SNOW_ROUGH: f32 = 0.9;

// Tabela de estilo, indexada pelo SLOT DO POOL (0..13). `world`: xy = canto
// (-X,-Z) do splat, z = lado em metros, w = slot da rocha das paredes.
struct TerrainChunkParams {
    tiles: array<vec4<f32>, 13>,
    tints: array<vec4<f32>, 13>,
    flats: array<vec4<f32>, 13>,
    roughs: array<vec4<f32>, 13>,
    world: vec4<f32>,
    day_tint: vec4<f32>,
    sun_dir: vec4<f32>,
    // walls_a = tri_slope, tri_soft, strata_spacing, strata_strength;
    // walls_b = rock_darken, streaks, moss, chuva.
    walls_a: vec4<f32>,
    walls_b: vec4<f32>,
    // snow = origem.xy, lado da célula, flag.
    // trail = centro.xy, lado do texel, flag.
    // trail_b = texels, molhado.
    // cloud = origem.xy, lado, transmitância média.
    // cloud_b = direção da luz.xyz, flag.
    snow: vec4<f32>,
    // snow_b = profundidade de referência fora da janela, escala da
    // codificação (d = v² · y), ganho do levantamento.
    snow_b: vec4<f32>,
    trail: vec4<f32>,
    trail_b: vec4<f32>,
    cloud: vec4<f32>,
    cloud_b: vec4<f32>,
};

@if(BINDLESS) {
// Uma entrada por material: o índice dos dados e as 144 entradas texture/
// sampler na ORDEM das bindings 1..144.
struct TerrainChunkBindings {
    material: u32,
    e: array<u32, 144>,
}

@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<storage> material_indices: array<TerrainChunkBindings>;
@group(constants::MATERIAL_BIND_GROUP) @binding(10) var<storage> params_array: array<TerrainChunkParams>;
} @else {
@group(constants::MATERIAL_BIND_GROUP) @binding(0) var<uniform> params_direct: TerrainChunkParams;
}

// Achatamento por distância: perto vê-se o material, longe vê-se cor. FLAT_MIN
// é o achatamento mínimo colado à câmara — as fotos do pool têm contraste a
// mais para um mundo cel-ish mesmo aos pés do herói. r4 (2026-09-09): os
// limites esticaram (42/260 → 64/340) — o detalhe morria aos ~100 m e as
// encostas ao fundo liam-se como cor chapada; a aerial perspective
// (320–1100 m) assume o resto do caminho até ao horizonte.
const FLAT_NEAR: f32 = 64.0;
const FLAT_FAR: f32 = 340.0;
const FLAT_MIN: f32 = 0.15;
// Limiar do SALTO de fetches: a partir daqui o mix devolve a cor plana e a
// normal já pesa < 0,5 % — os fetches de COR e de NORMAL MAP de cada layer não
// contribuem (o de HEIGHT fica: alimenta os pesos; o de AO fica: escurece a
// distância através dos mips). Poupa 2 dos 4 fetches por layer em toda a
// banda de fundo, que é o material dominante do ecrã em enquadramentos abertos.
const FLAT_SKIP: f32 = 0.995;

// Weights below this contribute nothing visible; skipping their texture
// fetch keeps the typical fragment at 2–3 layers instead of 4.
const WEIGHT_EPSILON: f32 = 0.004;

// Height-bias CONTÍNUO: cada layer ganha/perde peso proporcional à SUA
// altura (`h−0.5`), com teto/piso — a layer alta sai à frente na fronteira
// (a pedra sobre a relva) SEM colapso. A primeira versão redistribuía o
// PAR dominante com força 12: a layer perdedora colapsava a 0 e as
// fronteiras do splat — que são suaves — endureciam em LINHAS RETAS
// ("uma textura acaba, a outra começa", 2026-09-09). Multiplicativo com
// clamp é contínuo em todo o lado e mantém a largura da transição.
const HEIGHT_BIAS: f32 = 2.5;
/// Piso do multiplicador: a layer baixa nunca perde mais do que 65% do
/// peso — impossível desaparecer de golpe.
const HEIGHT_BIAS_MIN: f32 = 0.35;

// Força do AO do pool sobre o albedo (1 = total; 0.6 mantém o chão vivo).
const AO_STRENGTH: f32 = 0.6;


fn terrain_params(slot: u32) -> TerrainChunkParams {
    @if(BINDLESS)
    return params_array[material_indices[slot].material];
    @else
    return params_direct;
}

/// Uma textura da tabela (binding `b` = textura, `b + 1` = sampler) com
/// gradientes explícitos (legal no fluxo não-uniforme por camada).
fn map_sample(slot: u32, b: u32, uv: vec2<f32>, dx: vec2<f32>, dy: vec2<f32>) -> vec4<f32> {
    @if(BINDLESS) {
    // Indexar o storage DIRETAMENTE. `let idx = material_indices[slot]`
    // carregava a struct inteira (145 u32) para um valor e o índice dinâmico
    // `idx.e[b]` obrigava o naga a despejá-la numa variável local — uma
    // cópia de 580 B por amostra, ~40 amostras desenroladas.
    return textureSampleGrad(
        bindless_textures_2d[material_indices[slot].e[b - 1u]],
        bindless_samplers_filtering[material_indices[slot].e[b]],
        uv,
        dx,
        dy,
    );
    } @else {
    // Sem bindless não há texturas: neutro (o albedo cai na cor plana).
    return vec4<f32>(0.5, 0.5, 1.0, 1.0);
    }
}

fn layer_albedo(slot: u32, li: u32, uv: vec2<f32>, dx: vec2<f32>, dy: vec2<f32>) -> vec3<f32> {
    return map_sample(slot, B_ALBEDO + 2u * li, uv, dx, dy).rgb;
}

// ── Wall skin (deterministic hash noise — the rock detail needs no extra
// textures or bindings). Value noise in 2 octaves drives the runoff
// streaks and the moss patches.
fn hash21(p: vec2<f32>) -> f32 {
    return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);
}
fn vnoise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let a = mix(hash21(i), hash21(i + vec2<f32>(1.0, 0.0)), u.x);
    let b = mix(hash21(i + vec2<f32>(0.0, 1.0)), hash21(i + vec2<f32>(1.0, 1.0)), u.x);
    return mix(a, b, u.y);
}

// Anti-repetição: a 2.ª amostra roda ~34° e muda de escala (×0,37), e a
// mistura entre as duas segue um ruído de ~40 m — o padrão do azulejo deixa
// de alinhar ao longe.
const ANTI_TILE_SCALE: f32 = 0.37;
const ANTI_TILE_COS: f32 = 0.829;
const ANTI_TILE_SIN: f32 = 0.559;
const ANTI_TILE_MIX: f32 = 0.55;
// Variação macro de tom (campos de ~170 m e ~55 m): quebra a uniformidade das
// grandes áreas da mesma camada, perto e longe.
const MACRO_LOW: f32 = 0.88;
const MACRO_HIGH: f32 = 1.10;

fn anti_tile(v: vec2<f32>) -> vec2<f32> {
    return vec2<f32>(
        ANTI_TILE_COS * v.x - ANTI_TILE_SIN * v.y,
        ANTI_TILE_SIN * v.x + ANTI_TILE_COS * v.y,
    ) * ANTI_TILE_SCALE;
}

fn hermite(edge0: f32, edge1: f32, x: f32) -> f32 {
    let t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// Neve que assenta na face. Parede (normal_y baixo) fica quase seca.
// Igual a `ground::facing_snow`.
fn facing_snow(coverage: f32, normal_y: f32) -> f32 {
    let lo = 0.85 - 0.6 * coverage;
    return coverage * hermite(lo, lo + 0.2, normal_y);
}

// (0.25 + 0.75 T) / (0.25 + 0.75 T̄). Igual a `ground::cloud_shadow_ratio`.
fn cloud_shadow_ratio(t: f32, mean_t: f32) -> f32 {
    let here = 0.25 + 0.75 * t;
    let lights = max(0.25 + 0.75 * mean_t, 0.01);
    return clamp(here / lights, 0.0, 4.0);
}

// ── Neve volumétrica ─────────────────────────────────────────────────────
// O manto chega como profundidade (m) por célula de 2 m, codificada em R8
// (`ground::encode_depth`). O vertex levanta o chão por ela (só para cima)
// e o fragment pinta a neve, o relevo de vento e as pegadas (POM do campo de
// rastos do `bevy_elements`, portado de `trails::surface`).

/// Amostra sem gradientes (legal no vertex e em fluxo não-uniforme).
fn map_level(slot: u32, b: u32, uv: vec2<f32>) -> vec4<f32> {
    @if(BINDLESS) {
    return textureSampleLevel(
        bindless_textures_2d[material_indices[slot].e[b - 1u]],
        bindless_samplers_filtering[material_indices[slot].e[b]],
        uv,
        0.0,
    );
    } @else {
    return vec4<f32>(0.0);
    }
}

/// Profundidade do manto em `xz`, m. Junto à borda da janela funde com a
/// referência (o pack de um plano aberto), que vale também fora dela.
fn snow_depth_at(slot: u32, params: TerrainChunkParams, xz: vec2<f32>) -> f32 {
    if (params.snow.w < 0.5) {
        return 0.0;
    }
    let span = max(params.snow.z * SNOW_CELLS, 1e-3);
    let uv = (xz - params.snow.xy) / span;
    let edge = min(min(uv.x, uv.y), min(1.0 - uv.x, 1.0 - uv.y));
    let inside_k = hermite(0.0, 0.06, edge);
    var d = params.snow_b.x;
    if (inside_k > 0.0) {
        let v = map_level(slot, B_SNOW, clamp(uv, vec2<f32>(0.0), vec2<f32>(1.0))).r;
        d = mix(params.snow_b.x, v * v * params.snow_b.y, inside_k);
    }
    return d;
}

/// Superfície do manto: a profundidade com ondulação de vento (dunas de
/// ~3 m e cristas de ~0,8 m) proporcional a ela.
fn snow_relief(xz: vec2<f32>, depth: f32) -> f32 {
    if (depth <= 0.0) {
        return 0.0;
    }
    let dune = vnoise(xz * 0.31 + vec2<f32>(17.3, 5.1)) - 0.5;
    let ripple = vnoise(vec2<f32>(xz.x * 1.25 + xz.y * 0.4, xz.y * 1.25 - xz.x * 0.4)) - 0.5;
    return depth * max(1.0 + 0.45 * dune + 0.16 * ripple, 0.0);
}

/// Quanto uma face aceita o levantamento: chão sim, parede não.
fn snow_lift_weight(normal_y: f32) -> f32 {
    return hermite(0.35, 0.75, normal_y);
}

fn snow_surface(slot: u32, params: TerrainChunkParams, xz: vec2<f32>) -> f32 {
    return snow_relief(xz, snow_depth_at(slot, params, xz));
}

// Pegadas: o raio de vista contra o campo de rastos (`bevy_elements`
// `trails::surface::trail_march`, MIT/Apache, simplificado: sem a 2.ª
// passagem B-spline). `window` = (texel m, texels, 1, limite de |h|).
struct TrailHit {
    xz: vec2<f32>,
    h: f32,
    grad: vec2<f32>,
    open: f32,
    lit: f32,
}

fn trail_at(slot: u32, xz: vec2<f32>, window: vec4<f32>) -> vec4<f32> {
    return map_level(slot, B_TRAIL, xz / (window.x * window.y));
}

fn trail_march(
    slot: u32,
    window: vec4<f32>,
    p: vec3<f32>,
    eye: vec3<f32>,
    slope: vec2<f32>,
    l: vec3<f32>,
    fade: f32,
) -> TrailHit {
    var hit: TrailHit;
    hit.xz = p.xz;
    hit.h = 0.0;
    hit.grad = vec2<f32>(0.0);
    hit.open = 1.0;
    hit.lit = 1.0;
    let v = normalize(p - eye);
    let rise = v.y - dot(slope, v.xz);
    if (rise > -1.0e-3 || fade <= 0.0) {
        return hit;
    }
    let along = max(length(v.xz), 1.0e-3);
    let t0 = -min(0.1 / -rise, 2.5 / along);
    let t1 = min(window.w / -rise, 2.5 / along);
    let occupied = max(
        trail_at(slot, p.xz, window).y,
        max(trail_at(slot, p.xz + v.xz * t0, window).y, trail_at(slot, p.xz + v.xz * t1, window).y),
    );
    if (occupied < 1.0e-3) {
        return hit;
    }
    let n = i32(clamp(ceil((t1 - t0) * along / window.x), 8.0, 64.0));
    var lo = t0;
    var hi = t1;
    var lo_gap = 0.1;
    var hi_gap = 0.0;
    var crossed = false;
    for (var i = 1; i <= n; i += 1) {
        let t = mix(t0, t1, f32(i) / f32(n));
        let gap = rise * t - trail_at(slot, p.xz + v.xz * t, window).x * fade;
        if (gap <= 0.0) {
            hi = t;
            hi_gap = gap;
            crossed = true;
            break;
        }
        lo = t;
        lo_gap = gap;
    }
    if (!crossed) {
        let s = trail_at(slot, p.xz, window) * fade;
        hit.h = s.x;
        hit.grad = s.zw;
        return hit;
    }
    for (var k = 0; k < 5; k += 1) {
        let mid = 0.5 * (lo + hi);
        let gap = rise * mid - trail_at(slot, p.xz + v.xz * mid, window).x * fade;
        if (gap <= 0.0) {
            hi = mid;
            hi_gap = gap;
        } else {
            lo = mid;
            lo_gap = gap;
        }
    }
    let t_hit = mix(lo, hi, clamp(lo_gap / max(lo_gap - hi_gap, 1.0e-6), 0.0, 1.0));
    hit.xz = p.xz + v.xz * t_hit;
    let s = trail_at(slot, hit.xz, window) * fade;
    hit.h = s.x;
    let e = vec2<f32>(window.x, 0.0);
    hit.grad = fade * vec2<f32>(
        trail_at(slot, hit.xz + e.xy, window).x - trail_at(slot, hit.xz - e.xy, window).x,
        trail_at(slot, hit.xz + e.yx, window).x - trail_at(slot, hit.xz - e.yx, window).x,
    ) / (2.0 * window.x);
    let r = 0.12;
    var ring = 0.0;
    ring += trail_at(slot, hit.xz + vec2<f32>(r, 0.0), window).x;
    ring += trail_at(slot, hit.xz - vec2<f32>(r, 0.0), window).x;
    ring += trail_at(slot, hit.xz + vec2<f32>(0.0, r), window).x;
    ring += trail_at(slot, hit.xz - vec2<f32>(0.0, r), window).x;
    hit.open = 1.0 - 0.6 * clamp((0.25 * ring * fade - hit.h) / 0.25, 0.0, 1.0);
    if (l.y > 0.02) {
        let l_rise = max(l.y - dot(slope, l.xz), 0.02);
        let reach = min((0.1 - hit.h) / l_rise, 1.5);
        let du = max(window.x / max(length(l.xz), 1.0e-3), 1.5 / 24.0);
        let ns = i32(clamp(ceil(reach / du), 1.0, 24.0));
        var shadow = 0.0;
        for (var k = 1; k <= ns; k += 1) {
            let u = du * f32(k);
            let blocker = trail_at(slot, hit.xz + l.xz * u, window).x * fade;
            let ray = hit.h + l_rise * u;
            shadow = max(shadow, smoothstep(0.0, 1.0, (blocker - ray) / (0.01 + 0.25 * u)));
        }
        hit.lit = 1.0 - clamp(shadow, 0.0, 1.0);
    }
    return hit;
}

@vertex
fn vertex(vertex_in: Vertex) -> VertexOutput {
    var out: VertexOutput;
    let v = decompress_vertex(vertex_in, vertex_in.instance_index);
    let world_from_local = mesh_functions::get_world_from_local(vertex_in.instance_index);
    var wn = mesh_functions::mesh_normal_local_to_world(v.normal, vertex_in.instance_index);
    var wp = mesh_functions::mesh_position_local_to_world(world_from_local, vec4<f32>(v.position, 1.0));

    @if(BINDLESS)
    let slot = mesh[vertex_in.instance_index].material_and_lightmap_bind_group_slot & 0xffffu;
    @else
    let slot = 0u;
    let params = terrain_params(slot);
    if (params.snow.w > 0.5 && params.snow_b.z > 0.0) {
        let up = snow_lift_weight(normalize(wn).y);
        if (up > 0.0) {
            let xz = wp.xz;
            let lift = snow_surface(slot, params, xz);
            if (lift > 1.0e-4) {
                // A normal da superfície da neve por diferenças centrais.
                let e = 0.6;
                let gx = (snow_surface(slot, params, xz + vec2<f32>(e, 0.0))
                    - snow_surface(slot, params, xz - vec2<f32>(e, 0.0))) / (2.0 * e);
                let gz = (snow_surface(slot, params, xz + vec2<f32>(0.0, e))
                    - snow_surface(slot, params, xz - vec2<f32>(0.0, e))) / (2.0 * e);
                wp = vec4<f32>(wp.x, wp.y + lift * up * params.snow_b.z, wp.z, wp.w);
                let k = up * params.snow_b.z * hermite(0.0, 0.05, lift);
                wn = normalize(normalize(wn) - vec3<f32>(gx, 0.0, gz) * k);
            }
        }
    }

    out.world_normal = wn;
    out.world_position = wp;
    out.position = position_world_to_clip(wp.xyz);
    @if(VERTEX_UVS_A)
    out.uv = v.uv;
    @if(VERTEX_UVS_B)
    out.uv_b = v.uv_b;
    @if(VERTEX_TANGENTS)
    out.world_tangent = mesh_functions::mesh_tangent_local_to_world(
        world_from_local,
        v.tangent,
        vertex_in.instance_index,
    );
    @if(VERTEX_COLORS)
    out.color = v.color;
    @if(VERTEX_OUTPUT_INSTANCE_INDEX)
    out.instance_index = vertex_in.instance_index;
    @if(VISIBILITY_RANGE_DITHER)
    out.visibility_range_dither = mesh_functions::get_visibility_range_dither_level(
        vertex_in.instance_index,
        world_from_local[3],
    );
    return out;
}

@fragment
fn fragment(
    in: VertexOutput,
    @builtin(front_facing) is_front: bool,
) -> FragmentOutput {
    @if(BINDLESS)
    let slot = mesh[in.instance_index].material_and_lightmap_bind_group_slot & 0xffffu;
    @else
    let slot = 0u;
    var params = terrain_params(slot);

    let world = in.world_position.xyz;
    let normal = select(-in.world_normal, in.world_normal, is_front);

    // Splat GLOBAL: uv 0..1 sobre o mundo; gradientes tirados UMA vez aqui.
    let suv = (world.xz - params.world.xy) / params.world.z;
    let sdx = dpdx(suv);
    let sdy = dpdy(suv);
    let p0 = map_sample(slot, B_SPLAT, suv, sdx, sdy);
    let p1 = map_sample(slot, B_SPLAT + 2u, suv, sdx, sdy);
    let p2 = map_sample(slot, B_SPLAT + 4u, suv, sdx, sdy);
    let p3 = map_sample(slot, B_SPLAT + 6u, suv, sdx, sdy);
    // Empacotamento = `splat::SLOT_PACKING` (plano, canal) por slot.
    var w = array<f32, 13>(
        p0.r, p0.g, p0.b, p0.a,
        p1.r, p1.g, p1.b, p1.a,
        p2.r, p2.g, p2.b, p2.a,
        p3.r,
    );
    // As 4 camadas mais fortes deste pixel (inserção ordenada).
    var ids = array<u32, 4>(0u, 0u, 0u, 0u);
    var ws = array<f32, 4>(0.0, 0.0, 0.0, 0.0);
    for (var i = 0u; i < LAYERS; i++) {
        var v = w[i];
        var id = i;
        for (var k = 0u; k < 4u; k++) {
            if (v > ws[k]) {
                let tv = ws[k];
                let ti = ids[k];
                ws[k] = v;
                ids[k] = id;
                v = tv;
                id = ti;
            }
        }
    }
    let wtop = max(ws[0] + ws[1] + ws[2] + ws[3], 1e-4);

    // World-space derivative shared by every layer (uv = world / tile).
    let wdx = dpdx(world.xz);
    let wdy = dpdy(world.xz);

    // Achatamento por distância: perto vê-se o material, longe vê-se cor.
    let view_dist = distance(world, view.world_position.xyz);
    let flat_mix = mix(FLAT_MIN, 1.0, smoothstep(FLAT_NEAR, FLAT_FAR, view_dist));
    let tile_mix = smoothstep(0.30, 0.70, vnoise(world.xz / 40.0)) * ANTI_TILE_MIX;

    var albedo = vec3<f32>(0.0);
    var rough = 0.0;
    var ao = 0.0;
    var wsum = 0.0;
    // Frame tangente derivado da normal geométrica (projeção top-down).
    let ng = normalize(normal);
    let cross_up = cross(vec3<f32>(0.0, 1.0, 0.0), ng);
    let t_axis = select(vec3<f32>(1.0, 0.0, 0.0), normalize(cross_up), dot(cross_up, cross_up) > 1e-8);
    let b_axis = cross(ng, t_axis);
    var n_world = vec3<f32>(0.0);

    for (var k = 0u; k < 4u; k++) {
        let wk = ws[k] / wtop;
        if (wk <= WEIGHT_EPSILON) {
            continue;
        }
        let li = ids[k];
        let t = params.tiles[li].x;
        let uv_t = world.xz / t;
        let gx = wdx / t;
        let gy = wdy / t;
        var tex = params.flats[li].rgb;
        if (flat_mix < FLAT_SKIP) {
            var c = layer_albedo(slot, li, uv_t, gx, gy);
            if (tile_mix > 0.01) {
                // Desvio por camada: duas camadas nunca alinham o 2.º padrão.
                let shift = vec2<f32>(f32(li) * 0.173, f32(li) * 0.311);
                let c2 = layer_albedo(slot, li, anti_tile(uv_t) + shift, anti_tile(gx), anti_tile(gy));
                c = mix(c, c2, tile_mix);
            }
            tex = c * params.tints[li].rgb;
        }
        // Height-bias CONTÍNUO: multiplicador com piso — a camada alta ganha
        // peso na fronteira, a baixa perde um pouco, NINGUÉM colapsa.
        let h = map_sample(slot, B_HEIGHT + 2u * li, uv_t, gx, gy).r;
        let wb = wk * max(1.0 + HEIGHT_BIAS * (h - 0.5), HEIGHT_BIAS_MIN);
        albedo += wb * mix(tex, params.flats[li].rgb, flat_mix);
        if (params.roughs[li].y > 0.0) {
            let rmap = map_sample(slot, B_ROUGH + 2u * li, uv_t, gx, gy).r;
            let rinv = select(rmap, 1.0 - rmap, params.roughs[li].z > 0.5);
            rough += wb * mix(params.roughs[li].x, rinv, params.roughs[li].y);
        } else {
            rough += wb * params.roughs[li].x;
        }
        ao += wb * map_sample(slot, B_AO + 2u * li, uv_t, gx, gy).r;
        wsum += wb;
        let kd = 1.0 - flat_mix;
        if (kd >= 1.0 - FLAT_SKIP) {
            let nm = map_sample(slot, B_NORMAL + 2u * li, uv_t, gx, gy).rgb * 2.0 - 1.0;
            n_world += wb * (t_axis * (nm.x * kd) + b_axis * (nm.y * kd) + ng * (nm.z * kd + (1.0 - kd)));
        } else {
            n_world += wb * ng;
        }
    }

    let total = max(wsum, 1e-4);
    albedo /= total;
    rough = clamp(rough / total, 0.05, 1.0);
    albedo *= mix(1.0, ao / total, AO_STRENGTH);
    // Variação macro de tom (perto e longe).
    let macro_n = vnoise(world.xz / 170.0) * 0.6 + vnoise(world.xz / 55.0) * 0.4;
    albedo *= mix(MACRO_LOW, MACRO_HIGH, macro_n);
    let n_detail = normalize(select(ng, n_world, dot(n_world, n_world) > 1e-8));
    // Capture floor biome greenness/warmth before rock overwrite so moss follows
    // lush biomes and arid canyon cliffs warm toward weathered sandstone.
    let biome_green = clamp((albedo.g - albedo.r * 0.96) * 8.0, 0.0, 1.0);
    let floor_warmth = clamp((albedo.r - albedo.b) * 3.0, 0.0, 1.0) * (1.0 - biome_green);

    // Precompute screen-space UVs/derivatives in uniform control flow for triplanar walls.
    let uv_zy = vec2<f32>(world.z, world.y);
    let uv_xy = vec2<f32>(world.x, world.y);
    let dzy_x = dpdx(uv_zy);
    let dzy_y = dpdy(uv_zy);
    let dxy_x = dpdx(uv_xy);
    let dxy_y = dpdy(uv_xy);

    // ── Cliff walls, overhangs & cave mouths: 3-axis triplanar PBR + warped strata ─
    var wall_n = n_detail;
    var tri_mix = 0.0;
    if (params.walls_a.x < 1.0) {
        let geom_n = normalize(normal);
        let slope = clamp(1.0 - abs(geom_n.y), 0.0, 1.0);
        let overhang = smoothstep(-0.02, -0.35, geom_n.y);
        var region = 1.0;
        var wall = 0.5;
        @if(VERTEX_COLORS)
        {
            region = clamp(in.color.a, 0.0, 1.0);
            wall = clamp(in.color.r, 0.0, 1.0);
        }
        let brow_n = (vnoise(world.xz * 0.32) - 0.5) * 0.16
            + (vnoise(vec2<f32>(world.x + world.z, world.y) * 0.75) - 0.5) * 0.08;
        let slope_sheer = clamp(slope + brow_n, 0.0, 1.0);
        let sheer = smoothstep(0.32, 0.52, slope_sheer);
        let slope_n = clamp(slope + brow_n * max(region, sheer), 0.0, 1.0);
        let region_tri = smoothstep(params.walls_a.x, params.walls_a.x + params.walls_a.y, slope_n) * region;
        let tri = clamp(max(region_tri, max(overhang, sheer)), 0.0, 1.0);
        // Darken bright top-down scree/stone floor collars where they butt into cliff walls.
        let scree_bridge = 1.0 - 0.26 * region * smoothstep(0.14, 0.36, slope) * smoothstep(0.30, 0.85, wall);
        albedo *= scree_bridge;
        if (tri > 0.001) {
            let rock = u32(params.world.w);
            if (rock < LAYERS) {
                tri_mix = tri;
                let t = params.tiles[rock].x;
                let an = abs(geom_n);
                let aw = pow(an, vec3<f32>(4.0));
                let tw = aw / max(aw.x + aw.y + aw.z, 1e-4);

                let u_zy = uv_zy / t;
                let u_xy = uv_xy / t;
                let u_xz = world.xz / t;
                let dzy_dx = dzy_x / t;
                let dzy_dy = dzy_y / t;
                let dxy_dx = dxy_x / t;
                let dxy_dy = dxy_y / t;
                let dxz_dx = wdx / t;
                let dxz_dy = wdy / t;

                let detail = 1.0 - flat_mix;
                var rock_tex = params.flats[rock].rgb;
                var rock_ao = 1.0;
                var rock_rough = params.roughs[rock].x;
                var n_tri_pert = vec3<f32>(0.0);

                if (flat_mix < FLAT_SKIP) {
                    var c_sum = vec3<f32>(0.0);
                    var ao_sum = 0.0;
                    var r_sum = 0.0;
                    if (tw.x > 0.02) {
                        var cz = layer_albedo(slot, rock, u_zy, dzy_dx, dzy_dy);
                        if (tile_mix > 0.01) {
                            let c2 = layer_albedo(slot, rock, anti_tile(u_zy) + vec2<f32>(0.29, 0.17), anti_tile(dzy_dx), anti_tile(dzy_dy));
                            cz = mix(cz, c2, tile_mix * 0.75);
                        }
                        c_sum += cz * tw.x;
                        ao_sum += map_sample(slot, B_AO + 2u * rock, u_zy, dzy_dx, dzy_dy).r * tw.x;
                        if (params.roughs[rock].y > 0.0) {
                            let rm = map_sample(slot, B_ROUGH + 2u * rock, u_zy, dzy_dx, dzy_dy).r;
                            let rinv = select(rm, 1.0 - rm, params.roughs[rock].z > 0.5);
                            r_sum += mix(params.roughs[rock].x, rinv, params.roughs[rock].y) * tw.x;
                        } else {
                            r_sum += params.roughs[rock].x * tw.x;
                        }
                        let nm = map_sample(slot, B_NORMAL + 2u * rock, u_zy, dzy_dx, dzy_dy).rgb * 2.0 - 1.0;
                        n_tri_pert += vec3<f32>(0.0, -nm.y, nm.x) * tw.x;
                    }
                    if (tw.z > 0.02) {
                        var cx = layer_albedo(slot, rock, u_xy, dxy_dx, dxy_dy);
                        if (tile_mix > 0.01) {
                            let c2 = layer_albedo(slot, rock, anti_tile(u_xy) + vec2<f32>(0.41, 0.23), anti_tile(dxy_dx), anti_tile(dxy_dy));
                            cx = mix(cx, c2, tile_mix * 0.75);
                        }
                        c_sum += cx * tw.z;
                        ao_sum += map_sample(slot, B_AO + 2u * rock, u_xy, dxy_dx, dxy_dy).r * tw.z;
                        if (params.roughs[rock].y > 0.0) {
                            let rm = map_sample(slot, B_ROUGH + 2u * rock, u_xy, dxy_dx, dxy_dy).r;
                            let rinv = select(rm, 1.0 - rm, params.roughs[rock].z > 0.5);
                            r_sum += mix(params.roughs[rock].x, rinv, params.roughs[rock].y) * tw.z;
                        } else {
                            r_sum += params.roughs[rock].x * tw.z;
                        }
                        let nm = map_sample(slot, B_NORMAL + 2u * rock, u_xy, dxy_dx, dxy_dy).rgb * 2.0 - 1.0;
                        n_tri_pert += vec3<f32>(nm.x, -nm.y, 0.0) * tw.z;
                    }
                    if (tw.y > 0.02) {
                        let cy = layer_albedo(slot, rock, u_xz, dxz_dx, dxz_dy);
                        c_sum += cy * tw.y;
                        ao_sum += map_sample(slot, B_AO + 2u * rock, u_xz, dxz_dx, dxz_dy).r * tw.y;
                        if (params.roughs[rock].y > 0.0) {
                            let rm = map_sample(slot, B_ROUGH + 2u * rock, u_xz, dxz_dx, dxz_dy).r;
                            let rinv = select(rm, 1.0 - rm, params.roughs[rock].z > 0.5);
                            r_sum += mix(params.roughs[rock].x, rinv, params.roughs[rock].y) * tw.y;
                        } else {
                            r_sum += params.roughs[rock].x * tw.y;
                        }
                        let nm = map_sample(slot, B_NORMAL + 2u * rock, u_xz, dxz_dx, dxz_dy).rgb * 2.0 - 1.0;
                        n_tri_pert += vec3<f32>(nm.x, 0.0, -nm.y) * tw.y;
                    }
                    rock_tex = c_sum;
                    rock_ao = mix(1.0, ao_sum, 0.75);
                    rock_rough = r_sum;
                }

                // Geological dip + fold warp (no ruler-flat horizontal strata stripes)
                let dip = world.x * 0.045 - world.z * 0.032;
                let fold = (vnoise(world.xz * 0.055) - 0.5) * 2.6 + (vnoise(world.xz * 0.19) - 0.5) * 0.9;
                let y_warp = world.y + dip + fold;
                let band = y_warp / params.walls_a.z;
                let band_id = floor(band);
                let hue = fract(sin(band_id * vec3<f32>(12.9898, 78.233, 37.719)) * 43758.5453);
                let warm = vec3<f32>(
                    1.0 - params.walls_a.w,
                    1.0 - params.walls_a.w * 0.75,
                    1.0 - params.walls_a.w * 0.45,
                );
                let cool = vec3<f32>(
                    1.0 + params.walls_a.w * 0.45,
                    1.0 + params.walls_a.w * 0.75,
                    1.0 + params.walls_a.w,
                );
                let band_tint = mix(warm, cool, hue);
                let band_mod = band_id - floor(band_id * 0.25) * 4.0;
                let hard = step(band_mod, 0.5) * 0.14;
                let band_f = fract(band);
                let line = smoothstep(0.84, 0.99, band_f) * params.walls_a.w * 0.85;
                let fine_band = y_warp / (params.walls_a.z * 0.37);
                let seam = smoothstep(0.84, 0.99, fract(fine_band)) * params.walls_a.w * 0.40;
                // Vertical joint fissures breaking horizontal bedding planes
                let joint_u = (world.x * 0.7 + world.z * 0.7) * 0.36
                    + vnoise(vec2<f32>(world.x - world.z, world.y * 0.35) * 0.38) * 1.4;
                let joint_d = abs(fract(joint_u) - 0.5) * 2.0;
                let fissure = (1.0 - smoothstep(0.0, 0.085, joint_d))
                    * (0.45 + 0.55 * vnoise(vec2<f32>(world.y * 0.4, world.x * 0.3)));

                // Tangent-projected triplanar normal + bedding shelf bevel + detail fade
                let strata_lip = (smoothstep(0.76, 0.92, band_f) - smoothstep(0.92, 1.0, band_f) * 1.6) * 0.28;
                let lip_pert = vec3<f32>(0.0, strata_lip, 0.0);
                let n_raw_pert = n_tri_pert * 1.30 + lip_pert;
                let n_tan = n_raw_pert - geom_n * dot(n_raw_pert, geom_n);
                wall_n = normalize(geom_n + n_tan * detail);

                var rock_col = rock_tex * params.tints[rock].rgb * params.walls_b.x
                    * mix(vec3<f32>(1.0), vec3<f32>(1.24, 1.05, 0.80), floor_warmth * 0.55)
                    * rock_ao
                    * mix(vec3<f32>(1.0), band_tint, detail)
                    * (1.0 - (line + seam) * detail)
                    * (1.0 - fissure * 0.26 * detail)
                    * (1.0 + hard * detail);
                // Brow sun exposure, cave/overhang bounce AO, talus contact AO & damp streaks
                let weather = mix(1.06, 0.88, wall);
                let toe_ao = 1.0 - 0.38 * smoothstep(0.82, 0.98, wall);
                let ceiling_ao = 1.0 - 0.44 * overhang;
                let su = vec2<f32>((world.x + world.z) * 0.22, world.y * 0.06);
                let streak_n = vnoise(su) * 0.65 + vnoise(su * 2.7) * 0.35;
                let streak = 1.0
                    - params.walls_b.y * detail * smoothstep(0.48, 0.88, streak_n)
                    * mix(0.55, 1.0, max(wall, overhang));
                rock_col = rock_col * weather * toe_ao * ceiling_ao * streak;
                rock_col = mix(rock_col, params.flats[rock].rgb * (1.0 - 0.25 * overhang), flat_mix);
                albedo = mix(albedo, rock_col, tri);
                let wall_rough = clamp(mix(rock_rough, 0.54, overhang * 0.45) - fissure * 0.05, 0.24, 0.98);
                rough = mix(rough, wall_rough, tri);
            }
        }
        // Humic/moss collar along lush cliff shoulders & damp ledges; skipped on dry dunes.
        let moss_n = vnoise(world.xz * 0.17) * 0.6 + vnoise(world.xz * 0.51) * 0.4;
        let moss_band = smoothstep(0.10, 0.20, slope) * (1.0 - smoothstep(0.50, 0.78, slope))
            * smoothstep(-0.05, 0.20, geom_n.y);
        let moss = params.walls_b.z * region * biome_green * moss_band * (1.0 - flat_mix)
            * smoothstep(0.48, 0.78, moss_n)
            * mix(0.55, 1.25, wall);
        albedo = mix(albedo, vec3<f32>(0.16, 0.23, 0.08), clamp(moss, 0.0, 0.82));
    }

    // ── Margem erodida & humidade capilar (splat3.g = wet_rim, splat3.b = erosion) ─
    let detail_k = 1.0 - flat_mix;
    let wet_rim_map = p3.g;
    let bank_erode_map = p3.b;
    var shore_n_offset = vec3<f32>(0.0);
    var capillary_wet = 0.0;
    if (detail_k > 0.01 && (wet_rim_map > 0.004 || bank_erode_map > 0.004)) {
        // Organic shingle / damp soil micro-grain that breaks up 1 m splat edges.
        let g_coarse = vnoise(world.xz * 2.1);
        let g_fine = vnoise(world.xz * 6.9);
        let g_micro = vnoise(world.xz * 15.7);
        let shingle = g_coarse * 0.45 + g_fine * 0.35 + g_micro * 0.20;
        let tide_break = g_coarse * 0.65 + g_fine * 0.35;

        if (bank_erode_map > 0.004) {
            let erode_k = bank_erode_map * detail_k;
            let grain_tint = mix(0.76, 1.08, smoothstep(0.22, 0.78, shingle));
            albedo *= mix(1.0, grain_tint, erode_k * 0.72);
            rough = clamp(rough + (shingle - 0.45) * 0.14 * erode_k, 0.08, 1.0);
            let gx_e = vnoise((world.xz + vec2<f32>(0.18, 0.0)) * 6.9)
                - vnoise((world.xz - vec2<f32>(0.18, 0.0)) * 6.9);
            let gz_e = vnoise((world.xz + vec2<f32>(0.0, 0.18)) * 6.9)
                - vnoise((world.xz - vec2<f32>(0.0, 0.18)) * 6.9);
            shore_n_offset = vec3<f32>(-gx_e, 0.0, -gz_e) * (0.42 * erode_k);
        }

        if (wet_rim_map > 0.004) {
            capillary_wet = smoothstep(0.10, 0.90, wet_rim_map * (0.72 + 0.56 * tide_break))
                * detail_k;
            albedo *= mix(vec3<f32>(1.0), vec3<f32>(0.48, 0.47, 0.46), capillary_wet * 0.85);
            let wet_rough = mix(0.13, 0.30, smoothstep(0.45, 0.85, g_fine));
            rough = mix(rough, wet_rough, capillary_wet * 0.88);
        }
    }

    // ── Chuva: chão molhado (r3) ────────────────────────────────────────────
    // `walls_b.w` transporta a chuva (0..1, publisher `terrain_rain_wetness`).
    // Molhar = escurecer o albedo (água absorve) e abrir um gloss de poça no
    // CHÃO plano (a rocha das paredes já é rugosa ao natural); o specular do
    // sol/IBL faz o resto.
    let wet = clamp(params.walls_b.w, 0.0, 1.0) * (1.0 - clamp(tri_mix, 0.0, 1.0) * 0.7);
    let rain_extra = max(wet - capillary_wet, 0.0);
    if (rain_extra > 0.001) {
        albedo *= mix(1.0, 0.88, rain_extra);
        rough = mix(rough, 0.16, rain_extra);
    }

    // ── Aerial perspective (r2) ────────────────────────────────────────────
    // `day_tint` transporta agora o TINT DO HORIZONTE publicado pela
    // atmosfera (`w = 1` liga): o chão distante mistura-se para a cor do céu
    // ANTES da luz e da fog — as montanhas ao fundo leem-se da cor do ar
    // (azuis de dia, cor de crepúsculo à hora dourada) em vez de cinza
    // estéril. O achatamento FLAT_FAR dá-lhe a cor plana da layer; ISTO dá o
    // degradê atmosférico por cima dela.
    if (params.day_tint.w > 0.5) {
        let aerial = smoothstep(320.0, 1100.0, view_dist) * 0.55;
        albedo = mix(albedo, params.day_tint.rgb, aerial);
    }

    // ── PBR real ──────────────────────────────────────────────────────────
    // Sol direcional com sombras em cascata, luzes pontuais (clustered),
    // ambiente e specular — o mesmo caminho do StandardMaterial alimentado
    // com o nosso albedo/normal de 8 layers + triplanar. O `day_tint` do
    // caminho fake SAIU do albedo: com luz real, a hora do dia já escurece
    // e aquece o chão (sun_drive + daycycle_drive) e o tint compunha-se
    // duas vezes. `sun_dir`/`day_tint` continuam no uniform por compatibilidade
    // de layout (e para o `viber.debug.ground{...}`) mas já não são lidos.
    var n = normalize(mix(normalize(n_detail + shore_n_offset), wall_n, clamp(tri_mix, 0.0, 1.0)));

    // Manto e rastos. Flag a 0: não se amostra e o albedo fica o de hoje.
    var snow_k = 0.0;
    var snow_d = 0.0;
    var pressed = 0.0;
    var trail_open = 1.0;
    var trail_lit = 1.0;
    var snow_cav = 0.0;
    let geo_n = normalize(normal);
    if (params.snow.w > 0.5) {
        let depth = snow_depth_at(slot, params, world.xz);
        snow_d = snow_relief(world.xz, depth);
        // Depressões do relevo (vale de duna) mais azuis: sob luz difusa é a
        // pista que mostra o volume.
        snow_cav = clamp((depth - snow_d) / max(depth, 0.02) * 2.2, 0.0, 1.0);
        // Manto fino rompe em manchas: o limiar segue um ruído de ~1 m.
        let patchy = 0.55 + 0.6 * vnoise(world.xz * 0.9 + vec2<f32>(3.7, 11.2))
            + 0.25 * vnoise(world.xz * 3.3);
        let cover = hermite(0.0, 1.0, snow_d / 0.035 * patchy);
        snow_k = facing_snow(cover, geo_n.y);
        if (snow_k > 0.001 && view_dist < 90.0) {
            // Relevo fino por pixel (as cristas de vento são menores que a
            // malha): diferenças centrais da superfície.
            let e = 0.18;
            let gx = (snow_relief(world.xz + vec2<f32>(e, 0.0), depth)
                - snow_relief(world.xz - vec2<f32>(e, 0.0), depth)) / (2.0 * e);
            let gz = (snow_relief(world.xz + vec2<f32>(0.0, e), depth)
                - snow_relief(world.xz - vec2<f32>(0.0, e), depth)) / (2.0 * e);
            let fine = normalize(geo_n - vec3<f32>(gx, 0.0, gz) * hermite(90.0, 30.0, view_dist));
            n = normalize(mix(n, fine, snow_k));
        } else if (snow_k > 0.001) {
            n = normalize(mix(n, geo_n, snow_k));
        }
    }
    if (params.trail.w > 0.5 && params.trail_b.x > 1.0) {
        let texel = params.trail.z;
        let texels = params.trail_b.x;
        // Paredes e encostas íngremes não se pisam.
        let fade_win = 1.0 - hermite(0.85 * 0.5 * texel * texels, 0.97 * 0.5 * texel * texels,
            max(abs(world.x - params.trail.x), abs(world.z - params.trail.y)));
        let fade = fade_win * hermite(0.5, 0.6, geo_n.y);
        if (fade > 0.0) {
            let window = vec4<f32>(texel, texels, 1.0, max(snow_d, 0.05) + 0.05);
            let slope = -geo_n.xz / max(geo_n.y, 0.2);
            var l = vec3<f32>(0.0, 1.0, 0.0);
            if (params.sun_dir.w > 0.5) {
                l = normalize(-params.sun_dir.xyz);
            }
            let hit = trail_march(slot, window, world, view.world_position, slope, l, fade);
            pressed = max(-hit.h, 0.0);
            trail_open = hit.open;
            trail_lit = hit.lit;
            let tilt = vec3<f32>(hit.grad.x, 0.0, hit.grad.y) * geo_n.y;
            n = normalize(n - tilt);
            // No fundo de um sulco que chega ao chão vê-se o chão.
            if (pressed > 0.0) {
                let bared = hermite(snow_d - 0.02, snow_d, pressed);
                snow_k = snow_k * (1.0 - bared);
            }
            let dig = hermite(0.005, 0.03, pressed);
            if (params.trail_b.y > 0.35 && snow_k < 0.25) {
                let mud = dig * params.trail_b.y * fade;
                albedo = albedo * mix(1.0, 0.72, mud);
                rough = mix(rough, 0.35, mud);
            }
        }
    }
    if (snow_k > 0.001) {
        // Neve compactada no fundo da pegada, azulada nas cavidades.
        let packed = hermite(0.005, 0.04, pressed);
        var snow_albedo = SNOW_ALBEDO * mix(vec3<f32>(1.0), vec3<f32>(0.86, 0.89, 0.95), packed);
        snow_albedo = snow_albedo * mix(vec3<f32>(0.80, 0.87, 1.0), vec3<f32>(1.0), trail_open);
        snow_albedo = snow_albedo * mix(vec3<f32>(1.0), vec3<f32>(0.84, 0.89, 0.98), snow_cav);
        albedo = mix(albedo, snow_albedo, snow_k);
        rough = mix(rough, mix(SNOW_ROUGH, SNOW_ROUGH * 0.75, packed), snow_k);
    }

    var cloud_ratio = 1.0;
    if (params.cloud_b.w > 0.5 && params.cloud_b.y > 0.1) {
        let uv = (world.xz - params.cloud_b.xz * (world.y / params.cloud_b.y) - params.cloud.xy) / max(params.cloud.z, 1e-3);
        let dx = dpdx(uv);
        let dy = dpdy(uv);
        let inside = all(uv >= vec2<f32>(0.0)) && all(uv <= vec2<f32>(1.0));
        let t = select(1.0, map_sample(slot, B_CLOUD, uv, dx, dy).r, inside);
        cloud_ratio = cloud_shadow_ratio(t, params.cloud.w);
    }

    var pbr_input = pbr_input_new();
    pbr_input.flags = mesh[in.instance_index].flags;
    pbr_input.is_orthographic = view.clip_from_view[3].w == 1.0;
    pbr_input.V = calculate_view(in.world_position, pbr_input.is_orthographic);
    pbr_input.frag_coord = in.position;
    pbr_input.world_position = in.world_position;
    // A `world_normal` alimenta o normal-offset bias das sombras — normalizada,
    // com o flip de faces (cull off: a barriga dos overhangs é vista por dentro).
    pbr_input.world_normal = normalize(select(-in.world_normal, in.world_normal, is_front));
    pbr_input.N = n;
    // Opaco (alpha mode 0) + receptor de fog da câmara.
    pbr_input.material.flags = STANDARD_MATERIAL_FLAGS_FOG_ENABLED_BIT;
    pbr_input.material.base_color = vec4<f32>(albedo, 1.0);
    pbr_input.material.perceptual_roughness = rough;

    var diffuse_occlusion = vec3<f32>(1.0);
    var specular_occlusion = 1.0;
    @if(SCREEN_SPACE_AMBIENT_OCCLUSION)
    {
    let ssao = textureLoad(screen_space_ambient_occlusion_texture, vec2<i32>(in.position.xy), 0i).r;
    diffuse_occlusion = ssao_multibounce(ssao, albedo);
    // Lagarde and Rousiers 2014, "Moving Frostbite to Physically Based Rendering"
    let ndv = max(dot(n, pbr_input.V), 0.0001);
    let rough_linear = perceptualRoughnessToRoughness(rough);
    specular_occlusion = saturate(pow(ndv + ssao, exp2(-16.0 * rough_linear - 1.0)) - 1.0 + ssao);
    }
    pbr_input.diffuse_occlusion = diffuse_occlusion * trail_open;
    pbr_input.specular_occlusion = specular_occlusion;

    var out: FragmentOutput;
    out.color = apply_pbr_lighting(pbr_input);
    // A luz direta já leva a transmitância média. Isto só pinta a mancha local.
    // A sombra própria da pegada leva a parte direta da luz.
    let trail_shade = 1.0 - 0.55 * (1.0 - trail_lit);
    out.color = vec4<f32>(out.color.rgb * cloud_ratio * trail_shade, out.color.a);
    // Fog da câmara (`DistanceFog`): aplicada DENTRO do shader do material —
    // sem ela o terreno por layers lia o horizonte a 100% de contraste, as
    // transições de LOD ao longe ficavam duras e o pop-in de chunks era
    // visível. A ordem é a do pipeline: fog antes do tone mapping (nó de
    // pós-processo no 0.19 — TONEMAP_IN_SHADER não está definido aqui).
    out.color = main_pass_post_lighting_processing(pbr_input, out.color);
    return out;
}
