/target
# Estado/build do Jackdaw nas extensões (19 GB no checkout local; os bundles
# .jdext vão para os assets do GitHub Release, não para o git).
extensions/*/.jackdaw/
extensions/**/*.jdext

# Locks standalone de crates que eram workspaces próprios (antes de
# entrarem no workspace da raiz); manter por segurança em clones antigos.
crates/bevy_ext_engine/Cargo.lock
crates/bevy_ext_physics/Cargo.lock
.viber_engine_target/

# Builds dos crates standalone (excluídos da raiz; locks ficam, targets não)
crates/*/target/

# Worktrees locais de sessões concorrentes
.worktrees/

# Build das extensões Jackdaw (jd build)
extensions/*/target/

# Workspaces próprios dentro de crates/ (o do engine é standalone e tem o seu
# target de 12 GB; o `/target` da raiz não o cobre).
crates/*/target/
